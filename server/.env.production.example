# ============================================================
# 宝贝学习乐园 · BFF 生产环境变量模板
# 复制为 .env.production 并填入真实值；部署到云托管时建议直接
# 填在平台「环境变量」里，不要随代码上传（.gitignore 已拦截）。
# 值均可留空使用默认（括号内标注）。
# ============================================================

# StepFun（阶跃星辰）上游密钥（必填其一；step-* 模型走这里）
STEPFUN_API_KEY=

# StepFun 上游地址（默认 https://api.stepfun.com/v1）
STEPFUN_BASE_URL=

# Agnes 上游密钥（可选，step-* 之外的模型走这里）
AGNES_API_KEY=

# 上游地址（默认 https://api.agnes-ai.cn/v1）
AGNES_BASE_URL=

# 监听端口（云托管一般用 80/8080 或平台指定，默认 8787）
AI_PROXY_PORT=8787

# 并发闸门（默认 8）
AI_MAX_CONCURRENCY=8

# 全程超时 ms（默认 90000）
AI_TIMEOUT_MS=90000

# 每 IP 限流 / min（默认 30，公网建议 20）
AI_RATE_LIMIT_PER_MIN=30

# CORS 白名单，逗号分隔；留空 / * 为放开（默认放开）。
# 线上有独立静态站时建议填静态站域名，例如：
# AI_ALLOW_ORIGIN=https://5dff99b481cd499881ca01fde3105a60.bj6.agentos-app.net
AI_ALLOW_ORIGIN=

# 是否提供静态文件服务：1 开 / 0 关（默认 1；有独立静态托管时设 0）
AI_SERVE_STATIC=0
