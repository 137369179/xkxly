[{"title":"静夜思","author":"李白","dynasty":"唐","lines":["床前明月光，","疑是地上霜。","举头望明月，","低头思故乡。"],"tags":["思乡","月亮"],"level":1},{"title":"春晓","author":"孟浩然","dynasty":"唐","lines":["春眠不觉晓，","处处闻啼鸟。","夜来风雨声，","花落知多少。"],"tags":["春天","花"],"level":1},{"title":"咏鹅","author":"骆宾王","dynasty":"唐","lines":["鹅，鹅，鹅，","曲项向天歌。","白毛浮绿水，","红掌拨清波。"],"tags":["动物","植物"],"level":1},{"title":"悯农其二","author":"李绅","dynasty":"唐","lines":["锄禾日当午，","汗滴禾下土。","谁知盘中餐，","粒粒皆辛苦。"],"tags":["励志","田园"],"level":1},{"title":"登鹳雀楼","author":"王之涣","dynasty":"唐","lines":["白日依山尽，","黄河入海流。","欲穷千里目，","更上一层楼。"],"tags":["山水","励志"],"level":1},{"title":"望庐山瀑布","author":"李白","dynasty":"唐","lines":["日照香炉生紫烟，","遥看瀑布挂前川。","飞流直下三千尺，","疑是银河落九天。"],"tags":["山水","励志"],"level":1},{"title":"绝句两个黄鹂","author":"杜甫","dynasty":"唐","lines":["两个黄鹂鸣翠柳，","一行白鹭上青天。","窗含西岭千秋雪，","门泊东吴万里船。"],"tags":["动物","山水"],"level":1},{"title":"江雪","author":"柳宗元","dynasty":"唐","lines":["千山鸟飞绝，","万径人踪灭。","孤舟蓑笠翁，","独钓寒江雪。"],"tags":["冬天","雪"],"level":1},{"title":"小池","author":"杨万里","dynasty":"宋","lines":["泉眼无声惜细流，","树阴照水爱晴柔。","小荷才露尖尖角，","早有蜻蜓立上头。"],"tags":["夏天","植物"],"level":1},{"title":"村居","author":"高鼎","dynasty":"清","lines":["草长莺飞二月天，","拂堤杨柳醉春烟。","儿童散学归来早，","忙趁东风放纸鸢。"],"tags":["春天","童趣"],"level":1},{"title":"所见","author":"袁枚","dynasty":"清","lines":["牧童骑黄牛，","歌声振林樾。","意欲捕鸣蝉，","忽然闭口立。"],"tags":["童趣","动物"],"level":1},{"title":"池上","author":"白居易","dynasty":"唐","lines":["小娃撑小艇，","偷采白莲回。","不解藏踪迹，","浮萍一道开。"],"tags":["童趣","植物"],"level":1},{"title":"赋得古原草送别","author":"白居易","dynasty":"唐","lines":["离离原上草，","一岁一枯荣。","野火烧不尽，","春风吹又生。","远芳侵古道，","晴翠接荒城。","又送王孙去，","萋萋满别情。"],"tags":["送别","植物"],"level":2},{"title":"古朗月行节选","author":"李白","dynasty":"唐","lines":["小时不识月，","呼作白玉盘。","又疑瑶台镜，","飞在青云端。","仙人垂两足，","桂树何团团。","白兔捣药成，","问言与谁餐。"],"tags":["月亮","童趣"],"level":1},{"title":"风","author":"李峤","dynasty":"唐","lines":["解落三秋叶，","能开二月花。","过江千尺浪，","入竹万竿斜。"],"tags":["秋天","花"],"level":1},{"title":"鹿柴","author":"王维","dynasty":"唐","lines":["空山不见人，","但闻人语响。","返景入深林，","复照青苔上。"],"tags":["山水","冬天"],"level":1},{"title":"相思","author":"王维","dynasty":"唐","lines":["红豆生南国，","春来发几枝。","愿君多采撷，","此物最相思。"],"tags":["友情","植物"],"level":1},{"title":"杂诗君自故乡来","author":"王维","dynasty":"唐","lines":["君自故乡来，","应知故乡事。","来日绮窗前，","寒梅著花未。"],"tags":["思乡","植物"],"level":1},{"title":"九月九日忆山东兄弟","author":"王维","dynasty":"唐","lines":["独在异乡为异客，","每逢佳节倍思亲。","遥知兄弟登高处，","遍插茱萸少一人。"],"tags":["思乡","节日"],"level":1},{"title":"送元二使安西","author":"王维","dynasty":"唐","lines":["渭城朝雨浥轻尘，","客舍青青柳色新。","劝君更尽一杯酒，","西出阳关无故人。"],"tags":["送别","友情"],"level":2},{"title":"竹里馆","author":"王维","dynasty":"唐","lines":["独坐幽篁里，","弹琴复长啸。","深林人不知，","明月来相照。"],"tags":["山水","月亮"],"level":1},{"title":"山行","author":"杜牧","dynasty":"唐","lines":["远上寒山石径斜，","白云生处有人家。","停车坐爱枫林晚，","霜叶红于二月花。"],"tags":["秋天","山水"],"level":1},{"title":"清明","author":"杜牧","dynasty":"唐","lines":["清明时节雨纷纷，","路上行人欲断魂。","借问酒家何处有，","牧童遥指杏花村。"],"tags":["节日","雨"],"level":1},{"title":"江南春","author":"杜牧","dynasty":"唐","lines":["千里莺啼绿映红，","水村山郭酒旗风。","南朝四百八十寺，","多少楼台烟雨中。"],"tags":["春天","雨"],"level":2},{"title":"乐游原","author":"李商隐","dynasty":"唐","lines":["向晚意不适，","驱车登古原。","夕阳无限好，","只是近黄昏。"],"tags":["时间","励志"],"level":1},{"title":"寻隐者不遇","author":"贾岛","dynasty":"唐","lines":["松下问童子，","言师采药去。","只在此山中，","云深不知处。"],"tags":["山水","友情"],"level":1},{"title":"蜂","author":"罗隐","dynasty":"唐","lines":["不论平地与山尖，","无限风光尽被占。","采得百花成蜜后，","为谁辛苦为谁甜。"],"tags":["动物","植物"],"level":2},{"title":"小儿垂钓","author":"胡令能","dynasty":"唐","lines":["蓬头稚子学垂纶，","侧坐莓苔草映身。","路人借问遥招手，","怕得鱼惊不应人。"],"tags":["童趣","动物"],"level":1},{"title":"望天门山","author":"李白","dynasty":"唐","lines":["天门中断楚江开，","碧水东流至此回。","两岸青山相对出，","孤帆一片日边来。"],"tags":["山水","励志"],"level":1},{"title":"早发白帝城","author":"李白","dynasty":"唐","lines":["朝辞白帝彩云间，","千里江陵一日还。","两岸猿声啼不住，","轻舟已过万重山。"],"tags":["山水","励志"],"level":1},{"title":"黄鹤楼送孟浩然之广陵","author":"李白","dynasty":"唐","lines":["故人西辞黄鹤楼，","烟花三月下扬州。","孤帆远影碧空尽，","唯见长江天际流。"],"tags":["送别","友情"],"level":2},{"title":"赠汪伦","author":"李白","dynasty":"唐","lines":["李白乘舟将欲行，","忽闻岸上踏歌声。","桃花潭水深千尺，","不及汪伦送我情。"],"tags":["友情","送别"],"level":1},{"title":"独坐敬亭山","author":"李白","dynasty":"唐","lines":["众鸟高飞尽，","孤云独去闲。","相看两不厌，","只有敬亭山。"],"tags":["山水","动物"],"level":1},{"title":"夜宿山寺","author":"李白","dynasty":"唐","lines":["危楼高百尺，","手可摘星辰。","不敢高声语，","恐惊天上人。"],"tags":["励志","山水"],"level":1},{"title":"秋浦歌白发三千丈","author":"李白","dynasty":"唐","lines":["白发三千丈，","缘愁似个长。","不知明镜里，","何处得秋霜。"],"tags":["时间","励志"],"level":2},{"title":"绝句迟日江山丽","author":"杜甫","dynasty":"唐","lines":["迟日江山丽，","春风花草香。","泥融飞燕子，","沙暖睡鸳鸯。"],"tags":["春天","动物"],"level":1},{"title":"江畔独步寻花黄师塔","author":"杜甫","dynasty":"唐","lines":["黄师塔前江水东，","春光懒困倚微风。","桃花一簇开无主，","可爱深红爱浅红。"],"tags":["春天","花"],"level":1},{"title":"八阵图","author":"杜甫","dynasty":"唐","lines":["功盖三分国，","名成八阵图。","江流石不转，","遗恨失吞吴。"],"tags":["励志","山水"],"level":2},{"title":"逢雪宿芙蓉山主人","author":"刘长卿","dynasty":"唐","lines":["日暮苍山远，","天寒白屋贫。","柴门闻犬吠，","风雪夜归人。"],"tags":["冬天","雪"],"level":1},{"title":"送灵澈上人","author":"刘长卿","dynasty":"唐","lines":["苍苍竹林寺，","杳杳钟声晚。","荷笠带斜阳，","青山独归远。"],"tags":["送别","山水"],"level":1},{"title":"游子吟","author":"孟郊","dynasty":"唐","lines":["慈母手中线，","游子身上衣。","临行密密缝，","意恐迟迟归。","谁言寸草心，","报得三春晖。"],"tags":["母爱","励志"],"level":2},{"title":"枫桥夜泊","author":"张继","dynasty":"唐","lines":["月落乌啼霜满天，","江枫渔火对愁眠。","姑苏城外寒山寺，","夜半钟声到客船。"],"tags":["秋天","山水"],"level":1},{"title":"滁州西涧","author":"韦应物","dynasty":"唐","lines":["独怜幽草涧边生，","上有黄鹂深树鸣。","春潮带雨晚来急，","野渡无人舟自横。"],"tags":["春天","雨"],"level":1},{"title":"塞下曲月黑雁飞高","author":"卢纶","dynasty":"唐","lines":["月黑雁飞高，","单于夜遁逃。","欲将轻骑逐，","大雪满弓刀。"],"tags":["边塞","雪"],"level":1},{"title":"塞下曲林暗草惊风","author":"卢纶","dynasty":"唐","lines":["林暗草惊风，","将军夜引弓。","平明寻白羽，","没在石棱中。"],"tags":["边塞","动物"],"level":1},{"title":"悯农其一","author":"李绅","dynasty":"唐","lines":["春种一粒粟，","秋收万颗子。","四海无闲田，","农夫犹饿死。"],"tags":["田园","励志"],"level":1},{"title":"渡汉江","author":"宋之问","dynasty":"唐","lines":["岭外音书断，","经冬复历春。","近乡情更怯，","不敢问来人。"],"tags":["思乡","时间"],"level":1},{"title":"回乡偶书","author":"贺知章","dynasty":"唐","lines":["少小离家老大回，","乡音无改鬓毛衰。","儿童相见不相识，","笑问客从何处来。"],"tags":["思乡","时间"],"level":1},{"title":"咏柳","author":"贺知章","dynasty":"唐","lines":["碧玉妆成一树高，","万条垂下绿丝绦。","不知细叶谁裁出，","二月春风似剪刀。"],"tags":["春天","植物"],"level":1},{"title":"凉州词黄河远上","author":"王之涣","dynasty":"唐","lines":["黄河远上白云间，","一片孤城万仞山。","羌笛何须怨杨柳，","春风不度玉门关。"],"tags":["边塞","山水"],"level":2},{"title":"凉州词葡萄美酒","author":"王翰","dynasty":"唐","lines":["葡萄美酒夜光杯，","欲饮琵琶马上催。","醉卧沙场君莫笑，","古来征战几人回。"],"tags":["边塞","励志"],"level":2},{"title":"出塞","author":"王昌龄","dynasty":"唐","lines":["秦时明月汉时关，","万里长征人未还。","但使龙城飞将在，","不教胡马度阴山。"],"tags":["边塞","月亮"],"level":2},{"title":"芙蓉楼送辛渐","author":"王昌龄","dynasty":"唐","lines":["寒雨连江夜入吴，","平明送客楚山孤。","洛阳亲友如相问，","一片冰心在玉壶。"],"tags":["送别","友情"],"level":2},{"title":"从军行青海长云","author":"王昌龄","dynasty":"唐","lines":["青海长云暗雪山，","孤城遥望玉门关。","黄沙百战穿金甲，","不破楼兰终不还。"],"tags":["边塞","雪"],"level":2},{"title":"采莲曲","author":"王昌龄","dynasty":"唐","lines":["荷叶罗裙一色裁，","芙蓉向脸两边开。","乱入池中看不见，","闻歌始觉有人来。"],"tags":["夏天","植物"],"level":2},{"title":"宿建德江","author":"孟浩然","dynasty":"唐","lines":["移舟泊烟渚，","日暮客愁新。","野旷天低树，","江清月近人。"],"tags":["山水","月亮"],"level":1},{"title":"过故人庄","author":"孟浩然","dynasty":"唐","lines":["故人具鸡黍，","邀我至田家。","绿树村边合，","青山郭外斜。","开轩面场圃，","把酒话桑麻。","待到重阳日，","还来就菊花。"],"tags":["田园","友情"],"level":2},{"title":"夏日绝句","author":"李清照","dynasty":"宋","lines":["生当作人杰，","死亦为鬼雄。","至今思项羽，","不肯过江东。"],"tags":["励志","时间"],"level":1},{"title":"晓出净慈寺送林子方","author":"杨万里","dynasty":"宋","lines":["毕竟西湖六月中，","风光不与四时同。","接天莲叶无穷碧，","映日荷花别样红。"],"tags":["夏天","花"],"level":1},{"title":"宿新市徐公店","author":"杨万里","dynasty":"宋","lines":["篱落疏疏一径深，","树头新绿未成阴。","儿童急走追黄蝶，","飞入菜花无处寻。"],"tags":["春天","童趣"],"level":1},{"title":"春日","author":"朱熹","dynasty":"宋","lines":["胜日寻芳泗水滨，","无边光景一时新。","等闲识得东风面，","万紫千红总是春。"],"tags":["春天","花"],"level":1},{"title":"观书有感","author":"朱熹","dynasty":"宋","lines":["半亩方塘一鉴开，","天光云影共徘徊。","问渠那得清如许，","为有源头活水来。"],"tags":["读书","励志"],"level":2},{"title":"题西林壁","author":"苏轼","dynasty":"宋","lines":["横看成岭侧成峰，","远近高低各不同。","不识庐山真面目，","只缘身在此山中。"],"tags":["山水","励志"],"level":2},{"title":"饮湖上初晴后雨","author":"苏轼","dynasty":"宋","lines":["水光潋滟晴方好，","山色空蒙雨亦奇。","欲把西湖比西子，","淡妆浓抹总相宜。"],"tags":["山水","雨"],"level":1},{"title":"惠崇春江晚景","author":"苏轼","dynasty":"宋","lines":["竹外桃花三两枝，","春江水暖鸭先知。","蒌蒿满地芦芽短，","正是河豚欲上时。"],"tags":["春天","动物"],"level":1},{"title":"六月二十七日望湖楼醉书","author":"苏轼","dynasty":"宋","lines":["黑云翻墨未遮山，","白雨跳珠乱入船。","卷地风来忽吹散，","望湖楼下水如天。"],"tags":["夏天","雨"],"level":2},{"title":"四时田园杂兴昼出耘田","author":"范成大","dynasty":"宋","lines":["昼出耘田夜绩麻，","村庄儿女各当家。","童孙未解供耕织，","也傍桑阴学种瓜。"],"tags":["田园","童趣"],"level":1},{"title":"四时田园杂兴梅子金黄","author":"范成大","dynasty":"宋","lines":["梅子金黄杏子肥，","麦花雪白菜花稀。","日长篱落无人过，","惟有蜻蜓蛱蝶飞。"],"tags":["田园","夏天"],"level":1},{"title":"乡村四月","author":"翁卷","dynasty":"宋","lines":["绿遍山原白满川，","子规声里雨如烟。","乡村四月闲人少，","才了蚕桑又插田。"],"tags":["田园","雨"],"level":1},{"title":"墨梅","author":"王冕","dynasty":"元","lines":["我家洗砚池头树，","朵朵花开淡墨痕。","不要人夸好颜色，","只留清气满乾坤。"],"tags":["花","励志"],"level":2},{"title":"石灰吟","author":"于谦","dynasty":"明","lines":["千锤万凿出深山，","烈火焚烧若等闲。","粉骨碎身浑不怕，","要留清白在人间。"],"tags":["励志","动物"],"level":2},{"title":"竹石","author":"郑燮","dynasty":"清","lines":["咬定青山不放松，","立根原在破岩中。","千磨万击还坚劲，","任尔东西南北风。"],"tags":["植物","励志"],"level":2},{"title":"己亥杂诗浩荡离愁","author":"龚自珍","dynasty":"清","lines":["浩荡离愁白日斜，","吟鞭东指即天涯。","落红不是无情物，","化作春泥更护花。"],"tags":["励志","花"],"level":2},{"title":"论诗","author":"赵翼","dynasty":"清","lines":["李杜诗篇万口传，","至今已觉不新鲜。","江山代有才人出，","各领风骚数百年。"],"tags":["读书","励志"],"level":2},{"title":"舟夜书所见","author":"查慎行","dynasty":"清","lines":["月黑见渔灯，","孤光一点萤。","微微风簇浪，","散作满河星。"],"tags":["山水","月亮"],"level":1},{"title":"七步诗","author":"曹植","dynasty":"魏晋","lines":["煮豆燃豆萁，","豆在釜中泣。","本是同根生，","相煎何太急。"],"tags":["励志","动物"],"level":2},{"title":"敕勒歌","author":"佚名","dynasty":"南北朝","lines":["敕勒川，阴山下。","天似穹庐，笼盖四野。","天苍苍，野茫茫，","风吹草低见牛羊。"],"tags":["山水","动物"],"level":1},{"title":"江南","author":"佚名","dynasty":"汉","lines":["江南可采莲，","莲叶何田田。","鱼戏莲叶间。","鱼戏莲叶东，","鱼戏莲叶西，","鱼戏莲叶南，","鱼戏莲叶北。"],"tags":["植物","童趣"],"level":1},{"title":"乌衣巷","author":"刘禹锡","dynasty":"唐","lines":["朱雀桥边野草花，","乌衣巷口夕阳斜。","旧时王谢堂前燕，","飞入寻常百姓家。"],"tags":["时间","动物"],"level":2},{"title":"望洞庭","author":"刘禹锡","dynasty":"唐","lines":["湖光秋月两相和，","潭面无风镜未磨。","遥望洞庭山水翠，","白银盘里一青螺。"],"tags":["秋天","山水"],"level":1},{"title":"浪淘沙九曲黄河","author":"刘禹锡","dynasty":"唐","lines":["九曲黄河万里沙，","浪淘风簸自天涯。","如今直上银河去，","同到牵牛织女家。"],"tags":["山水","励志"],"level":2},{"title":"春夜喜雨","author":"杜甫","dynasty":"唐","lines":["好雨知时节，","当春乃发生。","随风潜入夜，","润物细无声。","野径云俱黑，","江船火独明。","晓看红湿处，","花重锦官城。"],"tags":["春天","雨"],"level":2},{"title":"春望","author":"杜甫","dynasty":"唐","lines":["国破山河在，","城春草木深。","感时花溅泪，","恨别鸟惊心。","烽火连三月，","家书抵万金。","白头搔更短，","浑欲不胜簪。"],"tags":["春天","思乡"],"level":2},{"title":"闻官军收河南河北","author":"杜甫","dynasty":"唐","lines":["剑外忽传收蓟北，","初闻涕泪满衣裳。","却看妻子愁何在，","漫卷诗书喜欲狂。","白日放歌须纵酒，","青春作伴好还乡。","即从巴峡穿巫峡，","便下襄阳向洛阳。"],"tags":["思乡","读书"],"level":2},{"title":"寒食","author":"韩翃","dynasty":"唐","lines":["春城无处不飞花，","寒食东风御柳斜。","日暮汉宫传蜡烛，","轻烟散入五侯家。"],"tags":["节日","春天"],"level":2},{"title":"弹琴","author":"刘长卿","dynasty":"唐","lines":["泠泠七弦上，","静听松风寒。","古调虽自爱，","今人多不弹。"],"tags":["山水","励志"],"level":2},{"title":"别董大","author":"高适","dynasty":"唐","lines":["千里黄云白日曛，","北风吹雁雪纷纷。","莫愁前路无知己，","天下谁人不识君。"],"tags":["送别","雪"],"level":2},{"title":"赠花卿","author":"杜甫","dynasty":"唐","lines":["锦城丝管日纷纷，","半入江风半入云。","此曲只应天上有，","人间能得几回闻。"],"tags":["友情","山水"],"level":2},{"title":"江畔独步寻花黄四娘","author":"杜甫","dynasty":"唐","lines":["黄四娘家花满蹊，","千朵万朵压枝低。","留连戏蝶时时舞，","自在娇莺恰恰啼。"],"tags":["春天","花"],"level":1},{"title":"暮江吟","author":"白居易","dynasty":"唐","lines":["一道残阳铺水中，","半江瑟瑟半江红。","可怜九月初三夜，","露似真珠月似弓。"],"tags":["秋天","月亮"],"level":1},{"title":"鸟鸣涧","author":"王维","dynasty":"唐","lines":["人闲桂花落，","夜静春山空。","月出惊山鸟，","时鸣春涧中。"],"tags":["春天","山水"],"level":2},{"title":"山中","author":"王维","dynasty":"唐","lines":["荆溪白石出，","天寒红叶稀。","山路元无雨，","空翠湿人衣。"],"tags":["山水","秋天"],"level":2},{"title":"田园乐","author":"王维","dynasty":"唐","lines":["桃红复含宿雨，","柳绿更带朝烟。","花落家童未扫，","莺啼山客犹眠。"],"tags":["田园","春天"],"level":2},{"title":"辛夷坞","author":"王维","dynasty":"唐","lines":["木末芙蓉花，","山中发红萼。","涧户寂无人，","纷纷开且落。"],"tags":["植物","山水"],"level":2},{"title":"莲花坞","author":"王维","dynasty":"唐","lines":["日日采莲去，","洲长多暮归。","弄篙莫溅水，","畏湿红莲衣。"],"tags":["植物","夏天"],"level":2},{"title":"白石滩","author":"王维","dynasty":"唐","lines":["清浅白石滩，","绿蒲向堪把。","家住水东西，","浣纱明月下。"],"tags":["山水","植物"],"level":2},{"title":"望洞庭湖赠张丞相","author":"孟浩然","dynasty":"唐","lines":["八月湖水平，","涵虚混太清。","气蒸云梦泽，","波撼岳阳城。","欲济无舟楫，","端居耻圣明。","坐观垂钓者，","徒有羡鱼情。"],"tags":["山水","励志"],"level":2},{"title":"渡浙江问舟中人","author":"孟浩然","dynasty":"唐","lines":["潮落江平未有风，","扁舟共济与君同。","时时引领望天末，","何处青山是越中。"],"tags":["山水","思乡"],"level":2},{"title":"送朱大入秦","author":"孟浩然","dynasty":"唐","lines":["游人五陵去，","宝剑值千金。","分手脱相赠，","平生一片心。"],"tags":["送别","友情"],"level":2},{"title":"岁暮归南山","author":"孟浩然","dynasty":"唐","lines":["北阙休上书，","南山归敝庐。","不才明主弃，","多病故人疏。","白发催年老，","青阳逼岁除。","永怀愁不寐，","松月夜窗虚。"],"tags":["思乡","时间"],"level":3},{"title":"客中作","author":"李白","dynasty":"唐","lines":["兰陵美酒郁金香，","玉碗盛来琥珀光。","但使主人能醉客，","不知何处是他乡。"],"tags":["思乡","友情"],"level":2},{"title":"玉阶怨","author":"李白","dynasty":"唐","lines":["玉阶生白露，","夜久侵罗袜。","却下水晶帘，","玲珑望秋月。"],"tags":["思乡","月亮"],"level":2},{"title":"劳劳亭","author":"李白","dynasty":"唐","lines":["天下伤心处，","劳劳送客亭。","春风知别苦，","不遣柳条青。"],"tags":["送别","春天"],"level":2},{"title":"山中问答","author":"李白","dynasty":"唐","lines":["问余何意栖碧山，","笑而不答心自闲。","桃花流水窅然去，","别有天地非人间。"],"tags":["山水","励志"],"level":2},{"title":"峨眉山月歌","author":"李白","dynasty":"唐","lines":["峨眉山月半轮秋，","影入平羌江水流。","夜发清溪向三峡，","思君不见下渝州。"],"tags":["月亮","山水"],"level":2},{"title":"春夜洛城闻笛","author":"李白","dynasty":"唐","lines":["谁家玉笛暗飞声，","散入春风满洛城。","此夜曲中闻折柳，","何人不起故园情。"],"tags":["思乡","春天"],"level":2},{"title":"江南逢李龟年","author":"杜甫","dynasty":"唐","lines":["岐王宅里寻常见，","崔九堂前几度闻。","正是江南好风景，","落花时节又逢君。"],"tags":["友情","春天"],"level":2},{"title":"江碧鸟逾白","author":"杜甫","dynasty":"唐","lines":["江碧鸟逾白，","山青花欲燃。","今春看又过，","何日是归年。"],"tags":["思乡","春天"],"level":2},{"title":"登岳阳楼","author":"杜甫","dynasty":"唐","lines":["昔闻洞庭水，","今上岳阳楼。","吴楚东南坼，","乾坤日夜浮。","亲朋无一字，","老病有孤舟。","戎马关山北，","凭轩涕泗流。"],"tags":["思乡","山水"],"level":3},{"title":"忆江南","author":"白居易","dynasty":"唐","lines":["江南好，","风景旧曾谙。","日出江花红胜火，","春来江水绿如蓝。","能不忆江南？"],"tags":["春天","山水"],"level":1},{"title":"大林寺桃花","author":"白居易","dynasty":"唐","lines":["人间四月芳菲尽，","山寺桃花始盛开。","长恨春归无觅处，","不知转入此中来。"],"tags":["花","春天"],"level":2},{"title":"遗爱寺","author":"白居易","dynasty":"唐","lines":["弄石临溪坐，","寻花绕寺行。","时时闻鸟语，","处处是泉声。"],"tags":["山水","动物"],"level":1},{"title":"钱塘湖春行","author":"白居易","dynasty":"唐","lines":["孤山寺北贾亭西，","水面初平云脚低。","几处早莺争暖树，","谁家新燕啄春泥。","乱花渐欲迷人眼，","浅草才能没马蹄。","最爱湖东行不足，","绿杨阴里白沙堤。"],"tags":["春天","山水"],"level":2},{"title":"问刘十九","author":"白居易","dynasty":"唐","lines":["绿蚁新醅酒，","红泥小火炉。","晚来天欲雪，","能饮一杯无？"],"tags":["友情","雪"],"level":2},{"title":"浪淘沙","author":"白居易","dynasty":"唐","lines":["白浪茫茫与海连，","平沙浩浩四无边。","暮去朝来淘不住，","遂令东海变桑田。"],"tags":["山水","时间"],"level":2},{"title":"秋夕","author":"杜牧","dynasty":"唐","lines":["银烛秋光冷画屏，","轻罗小扇扑流萤。","天阶夜色凉如水，","卧看牵牛织女星。"],"tags":["秋天","月亮"],"level":2},{"title":"泊秦淮","author":"杜牧","dynasty":"唐","lines":["烟笼寒水月笼沙，","夜泊秦淮近酒家。","商女不知亡国恨，","隔江犹唱后庭花。"],"tags":["秋天","月亮"],"level":3},{"title":"寄扬州韩绰判官","author":"杜牧","dynasty":"唐","lines":["青山隐隐水迢迢，","秋尽江南草未凋。","二十四桥明月夜，","玉人何处教吹箫。"],"tags":["秋天","月亮"],"level":2},{"title":"赠别","author":"杜牧","dynasty":"唐","lines":["娉娉袅袅十三余，","豆蔻梢头二月初。","春风十里扬州路，","卷上珠帘总不如。"],"tags":["送别","友情"],"level":2},{"title":"过华清宫","author":"杜牧","dynasty":"唐","lines":["长安回望绣成堆，","山顶千门次第开。","一骑红尘妃子笑，","无人知是荔枝来。"],"tags":["动物","花"],"level":2},{"title":"题乌江亭","author":"杜牧","dynasty":"唐","lines":["胜败兵家事不期，","包羞忍耻是男儿。","江东子弟多才俊，","卷土重来未可知。"],"tags":["励志","时间"],"level":2},{"title":"夜雨寄北","author":"李商隐","dynasty":"唐","lines":["君问归期未有期，","巴山夜雨涨秋池。","何当共剪西窗烛，","却话巴山夜雨时。"],"tags":["思乡","雨"],"level":2},{"title":"嫦娥","author":"李商隐","dynasty":"唐","lines":["云母屏风烛影深，","长河渐落晓星沉。","嫦娥应悔偷灵药，","碧海青天夜夜心。"],"tags":["月亮","秋天"],"level":2},{"title":"霜月","author":"李商隐","dynasty":"唐","lines":["初闻征雁已无蝉，","百尺楼高水接天。","青女素娥俱耐冷，","月中霜里斗婵娟。"],"tags":["月亮","秋天"],"level":2},{"title":"宿骆氏亭寄怀崔雍崔衮","author":"李商隐","dynasty":"唐","lines":["竹坞无尘水槛清，","相思迢递隔重城。","秋阴不散霜飞晚，","留得枯荷听雨声。"],"tags":["秋天","雨"],"level":2},{"title":"贾生","author":"李商隐","dynasty":"唐","lines":["宣室求贤访逐臣，","贾生才调更无伦。","可怜夜半虚前席，","不问苍生问鬼神。"],"tags":["励志","时间"],"level":3},{"title":"从军行其五","author":"王昌龄","dynasty":"唐","lines":["大漠风尘日色昏，","红旗半卷出辕门。","前军夜战洮河北，","已报生擒吐谷浑。"],"tags":["边塞","励志"],"level":2},{"title":"闺怨","author":"王昌龄","dynasty":"唐","lines":["闺中少妇不知愁，","春日凝妆上翠楼。","忽见陌头杨柳色，","悔教夫婿觅封侯。"],"tags":["思乡","春天"],"level":2},{"title":"逢入京使","author":"岑参","dynasty":"唐","lines":["故园东望路漫漫，","双袖龙钟泪不干。","马上相逢无纸笔，","凭君传语报平安。"],"tags":["思乡","送别"],"level":2},{"title":"碛中作","author":"岑参","dynasty":"唐","lines":["走马西来欲到天，","辞家见月两回圆。","今夜不知何处宿，","平沙万里绝人烟。"],"tags":["思乡","边塞"],"level":2},{"title":"山房春事","author":"岑参","dynasty":"唐","lines":["梁园日暮乱飞鸦，","极目萧条三两家。","庭树不知人去尽，","春来还发旧时花。"],"tags":["春天","花"],"level":2},{"title":"戏问花门酒家翁","author":"岑参","dynasty":"唐","lines":["老人七十仍沽酒，","千壶百瓮花门口。","道傍榆荚仍似钱，","摘来沽酒君肯否？"],"tags":["花","友情"],"level":2},{"title":"秋夜寄邱员外","author":"韦应物","dynasty":"唐","lines":["怀君属秋夜，","散步咏凉天。","空山松子落，","幽人应未眠。"],"tags":["友情","秋天"],"level":2},{"title":"闻雁","author":"韦应物","dynasty":"唐","lines":["故园渺何处，","归思方悠哉。","淮南秋雨夜，","高斋闻雁来。"],"tags":["思乡","秋天"],"level":2},{"title":"赋得暮雨送李胄","author":"韦应物","dynasty":"唐","lines":["楚江微雨里，","建业暮钟时。","漠漠帆来重，","冥冥鸟去迟。","海门深不见，","浦树远含滋。","相送情无限，","沾襟比散丝。"],"tags":["送别","雨"],"level":3},{"title":"竹枝词","author":"刘禹锡","dynasty":"唐","lines":["杨柳青青江水平，","闻郎江上踏歌声。","东边日出西边雨，","道是无晴却有晴。"],"tags":["春天","友情"],"level":2},{"title":"石头城","author":"刘禹锡","dynasty":"唐","lines":["山围故国周遭在，","潮打空城寂寞回。","淮水东边旧时月，","夜深还过女墙来。"],"tags":["时间","山水"],"level":3},{"title":"秋词","author":"刘禹锡","dynasty":"唐","lines":["自古逢秋悲寂寥，","我言秋日胜春朝。","晴空一鹤排云上，","便引诗情到碧霄。"],"tags":["秋天","励志"],"level":2},{"title":"再游玄都观","author":"刘禹锡","dynasty":"唐","lines":["百亩庭中半是苔，","桃花净尽菜花开。","种桃道士归何处，","前度刘郎今又来。"],"tags":["花","时间"],"level":2},{"title":"采莲曲","author":"贺知章","dynasty":"唐","lines":["稽山云雾郁嵯峨，","镜水无风也自波。","莫言春度芳菲尽，","别有中流采芰荷。"],"tags":["植物","山水"],"level":2},{"title":"渔翁","author":"柳宗元","dynasty":"唐","lines":["渔翁夜傍西岩宿，","晓汲清湘燃楚竹。","烟销日出不见人，","欸乃一声山水绿。","回看天际下中流，","岩上无心云相逐。"],"tags":["山水","动物"],"level":3},{"title":"与浩初上人同看山寄京华亲故","author":"柳宗元","dynasty":"唐","lines":["海畔尖山似剑铓，","秋来处处割愁肠。","若为化得身千亿，","散上峰头望故乡。"],"tags":["思乡","山水"],"level":3},{"title":"题破山寺后禅院","author":"常建","dynasty":"唐","lines":["清晨入古寺，","初日照高林。","曲径通幽处，","禅房花木深。","山光悦鸟性，","潭影空人心。","万籁此俱寂，","但余钟磬音。"],"tags":["山水","励志"],"level":3},{"title":"剑客","author":"贾岛","dynasty":"唐","lines":["十年磨一剑，","霜刃未曾试。","今日把示君，","谁有不平事？"],"tags":["励志","时间"],"level":2},{"title":"题诗后","author":"贾岛","dynasty":"唐","lines":["两句三年得，","一吟双泪流。","知音如不赏，","归卧故山秋。"],"tags":["励志","读书"],"level":2},{"title":"夜上受降城闻笛","author":"李益","dynasty":"唐","lines":["回乐峰前沙似雪，","受降城外月如霜。","不知何处吹芦管，","一夜征人尽望乡。"],"tags":["边塞","月亮"],"level":2},{"title":"赠刘景文","author":"苏轼","dynasty":"宋","lines":["荷尽已无擎雨盖，","菊残犹有傲霜枝。","一年好景君须记，","最是橙黄橘绿时。"],"tags":["秋天","植物","励志"],"level":2},{"title":"春宵","author":"苏轼","dynasty":"宋","lines":["春宵一刻值千金，","花有清香月有阴。","歌管楼台声细细，","秋千院落夜沉沉。"],"tags":["春天","月亮","时间"],"level":2},{"title":"海棠","author":"苏轼","dynasty":"宋","lines":["东风袅袅泛崇光，","香雾空蒙月转廊。","只恐夜深花睡去，","故烧高烛照红妆。"],"tags":["花","春天"],"level":2},{"title":"花影","author":"苏轼","dynasty":"宋","lines":["重重叠叠上瑶台，","几度呼童扫不开。","刚被太阳收拾去，","却教明月送将来。"],"tags":["花","月亮"],"level":2},{"title":"中秋月","author":"苏轼","dynasty":"宋","lines":["暮云收尽溢清寒，","银汉无声转玉盘。","此生此夜不长好，","明月明年何处看。"],"tags":["月亮","秋天","思乡"],"level":2},{"title":"东坡","author":"苏轼","dynasty":"宋","lines":["雨洗东坡月色清，","市人行尽野人行。","莫嫌荦确坡头路，","自爱铿然曳杖声。"],"tags":["山水","励志"],"level":2},{"title":"琴诗","author":"苏轼","dynasty":"宋","lines":["若言琴上有琴声，","放在匣中何不鸣？","若言声在指头上，","何不于君指上听？"],"tags":["励志","读书"],"level":2},{"title":"惠州一绝","author":"苏轼","dynasty":"宋","lines":["罗浮山下四时春，","卢橘杨梅次第新。","日啖荔枝三百颗，","不辞长作岭南人。"],"tags":["植物","励志"],"level":2},{"title":"洗儿","author":"苏轼","dynasty":"宋","lines":["人皆养子望聪明，","我被聪明误一生。","惟愿孩儿愚且鲁，","无灾无难到公卿。"],"tags":["童趣","母爱"],"level":2},{"title":"元日","author":"王安石","dynasty":"宋","lines":["爆竹声中一岁除，","春风送暖入屠苏。","千门万户曈曈日，","总把新桃换旧符。"],"tags":["节日","冬天","励志"],"level":2},{"title":"泊船瓜洲","author":"王安石","dynasty":"宋","lines":["京口瓜洲一水间，","钟山只隔数重山。","春风又绿江南岸，","明月何时照我还。"],"tags":["思乡","春天","月亮"],"level":2},{"title":"梅花","author":"王安石","dynasty":"宋","lines":["墙角数枝梅，","凌寒独自开。","遥知不是雪，","为有暗香来。"],"tags":["冬天","植物","花"],"level":2},{"title":"书湖阴先生壁","author":"王安石","dynasty":"宋","lines":["茅檐长扫净无苔，","花木成畦手自栽。","一水护田将绿绕，","两山排闼送青来。"],"tags":["田园","山水","植物"],"level":2},{"title":"江上","author":"王安石","dynasty":"宋","lines":["江北秋阴一半开，","晚云含雨却低回。","青山缭绕疑无路，","忽见千帆隐映来。"],"tags":["山水","秋天"],"level":2},{"title":"钟山即事","author":"王安石","dynasty":"宋","lines":["涧水无声绕竹流，","竹西花草弄春柔。","茅檐相对坐终日，","一鸟不鸣山更幽。"],"tags":["山水","春天","动物"],"level":2},{"title":"北山","author":"王安石","dynasty":"宋","lines":["北山输绿涨横陂，","直堑回塘滟滟时。","细数落花因坐久，","缓寻芳草得迟归。"],"tags":["山水","春天","花"],"level":2},{"title":"登飞来峰","author":"王安石","dynasty":"宋","lines":["飞来山上千寻塔，","闻说鸡鸣见日升。","不畏浮云遮望眼，","自缘身在最高层。"],"tags":["山水","励志"],"level":2},{"title":"示儿","author":"陆游","dynasty":"宋","lines":["死去元知万事空，","但悲不见九州同。","王师北定中原日，","家祭无忘告乃翁。"],"tags":["励志","思乡"],"level":3},{"title":"秋夜将晓出篱门迎凉有感","author":"陆游","dynasty":"宋","lines":["三万里河东入海，","五千仞岳上摩天。","遗民泪尽胡尘里，","南望王师又一年。"],"tags":["秋天","励志","思乡"],"level":3},{"title":"冬夜读书示子聿","author":"陆游","dynasty":"宋","lines":["古人学问无遗力，","少壮工夫老始成。","纸上得来终觉浅，","绝知此事要躬行。"],"tags":["读书","励志","冬天"],"level":3},{"title":"游山西村","author":"陆游","dynasty":"宋","lines":["莫笑农家腊酒浑，","丰年留客足鸡豚。","山重水复疑无路，","柳暗花明又一村。","箫鼓追随春社近，","衣冠简朴古风存。","从今若许闲乘月，","拄杖无时夜叩门。"],"tags":["田园","友情","山水"],"level":3},{"title":"十一月四日风雨大作","author":"陆游","dynasty":"宋","lines":["僵卧孤村不自哀，","尚思为国戍轮台。","夜阑卧听风吹雨，","铁马冰河入梦来。"],"tags":["励志","雨","冬天"],"level":3},{"title":"沈园","author":"陆游","dynasty":"宋","lines":["城上斜阳画角哀，","沈园非复旧池台。","伤心桥下春波绿，","曾是惊鸿照影来。"],"tags":["春天","花"],"level":3},{"title":"临安春雨初霁","author":"陆游","dynasty":"宋","lines":["世味年来薄似纱，","谁令骑马客京华。","小楼一夜听春雨，","深巷明朝卖杏花。","矮纸斜行闲作草，","晴窗细乳戏分茶。","素衣莫起风尘叹，","犹及清明可到家。"],"tags":["春天","雨","花"],"level":3},{"title":"闲居初夏午睡起","author":"杨万里","dynasty":"宋","lines":["梅子留酸软齿牙，","芭蕉分绿与窗纱。","日长睡起无情思，","闲看儿童捉柳花。"],"tags":["夏天","童趣","植物"],"level":2},{"title":"新柳","author":"杨万里","dynasty":"宋","lines":["柳条百尺拂银塘，","且莫深青只浅黄。","未必柳条能蘸水，","水中柳影引他长。"],"tags":["春天","植物"],"level":2},{"title":"稚子弄冰","author":"杨万里","dynasty":"宋","lines":["稚子金盆脱晓冰，","彩丝穿取当银钲。","敲成玉磬穿林响，","忽作玻璃碎地声。"],"tags":["冬天","童趣"],"level":2},{"title":"舟过安仁","author":"杨万里","dynasty":"宋","lines":["一叶渔船两小童，","收篙停棹坐船中。","怪生无雨都张伞，","不是遮头是使风。"],"tags":["童趣","夏天"],"level":2},{"title":"桑茶坑道中","author":"杨万里","dynasty":"宋","lines":["晴明风日雨干时，","草满花堤水满溪。","童子柳阴眠正着，","一牛吃过柳阴西。"],"tags":["夏天","童趣","动物"],"level":2},{"title":"夏夜追凉","author":"杨万里","dynasty":"宋","lines":["夜热依然午热同，","开门小立月明中。","竹深树密虫鸣处，","时有微凉不是风。"],"tags":["夏天","月亮"],"level":2},{"title":"过松源晨炊漆公店","author":"杨万里","dynasty":"宋","lines":["莫言下岭便无难，","赚得行人错喜欢。","正入万山圈子里，","一山放出一山拦。"],"tags":["山水","励志"],"level":2},{"title":"闲居初夏午睡起·其二","author":"杨万里","dynasty":"宋","lines":["松阴一架半弓苔，","偶欲看书又懒开。","戏掬清泉洒蕉叶，","儿童误认雨声来。"],"tags":["夏天","童趣","植物"],"level":2},{"title":"最爱东山晴后雪","author":"杨万里","dynasty":"宋","lines":["只知逐胜忽忘寒，","小立春风夕照间。","最爱东山晴后雪，","软红光里涌银山。"],"tags":["冬天","雪","山水"],"level":2},{"title":"州桥","author":"范成大","dynasty":"宋","lines":["州桥南北是天街，","父老年年等驾回。","忍泪失声询使者，","几时真有六军来。"],"tags":["思乡","励志"],"level":3},{"title":"横塘","author":"范成大","dynasty":"宋","lines":["南浦春来绿一川，","石桥朱塔两依然。","年年送客横塘路，","细雨垂杨系画船。"],"tags":["送别","春天","山水"],"level":2},{"title":"观书有感·其二","author":"朱熹","dynasty":"宋","lines":["昨夜江边春水生，","蒙冲巨舰一毛轻。","向来枉费推移力，","此日中流自在行。"],"tags":["读书","励志","山水"],"level":2},{"title":"偶成","author":"朱熹","dynasty":"宋","lines":["少年易老学难成，","一寸光阴不可轻。","未觉池塘春草梦，","阶前梧叶已秋声。"],"tags":["读书","时间","励志"],"level":2},{"title":"西江月·夜行黄沙道中","author":"辛弃疾","dynasty":"宋","lines":["明月别枝惊鹊，","清风半夜鸣蝉。","稻花香里说丰年，","听取蛙声一片。","七八个星天外，","两三点雨山前。","旧时茅店社林边，","路转溪桥忽见。"],"tags":["夏天","月亮","田园"],"level":2},{"title":"清平乐·村居","author":"辛弃疾","dynasty":"宋","lines":["茅檐低小，","溪上青青草。","醉里吴音相媚好，","白发谁家翁媪？","大儿锄豆溪东，","中儿正织鸡笼。","最喜小儿亡赖，","溪头卧剥莲蓬。"],"tags":["田园","童趣","夏天"],"level":2},{"title":"如梦令·常记溪亭日暮","author":"李清照","dynasty":"宋","lines":["常记溪亭日暮，","沉醉不知归路。","兴尽晚回舟，","误入藕花深处。","争渡，","争渡，","惊起一滩鸥鹭。"],"tags":["夏天","花","童趣"],"level":2},{"title":"如梦令·昨夜雨疏风骤","author":"李清照","dynasty":"宋","lines":["昨夜雨疏风骤，","浓睡不消残酒。","试问卷帘人，","却道海棠依旧。","知否，","知否，","应是绿肥红瘦。"],"tags":["花","春天","雨"],"level":2},{"title":"游园不值","author":"叶绍翁","dynasty":"宋","lines":["应怜屐齿印苍苔，","小扣柴扉久不开。","春色满园关不住，","一枝红杏出墙来。"],"tags":["春天","花","植物"],"level":2},{"title":"三衢道中","author":"曾几","dynasty":"宋","lines":["梅子黄时日日晴，","小溪泛尽却山行。","绿阴不减来时路，","添得黄鹂四五声。"],"tags":["夏天","山水","动物"],"level":2},{"title":"村晚","author":"雷震","dynasty":"宋","lines":["草满池塘水满陂，","山衔落日浸寒漪。","牧童归去横牛背，","短笛无腔信口吹。"],"tags":["夏天","童趣","田园"],"level":2},{"title":"绝句·古木阴中系短篷","author":"志南","dynasty":"宋","lines":["古木阴中系短篷，","杖藜扶我过桥东。","沾衣欲湿杏花雨，","吹面不寒杨柳风。"],"tags":["春天","雨","植物"],"level":2},{"title":"题临安邸","author":"林升","dynasty":"宋","lines":["山外青山楼外楼，","西湖歌舞几时休。","暖风熏得游人醉，","直把杭州作汴州。"],"tags":["励志","山水","思乡"],"level":3},{"title":"雪梅·其一","author":"卢梅坡","dynasty":"宋","lines":["梅雪争春未肯降，","骚人阁笔费评章。","梅须逊雪三分白，","雪却输梅一段香。"],"tags":["冬天","雪","花"],"level":2},{"title":"雪梅·其二","author":"卢梅坡","dynasty":"宋","lines":["有梅无雪不精神，","有雪无诗俗了人。","日暮诗成天又雪，","与梅并作十分春。"],"tags":["冬天","雪","花"],"level":2},{"title":"社日","author":"王驾","dynasty":"宋","lines":["鹅湖山下稻粱肥，","豚栅鸡栖半掩扉。","桑柘影斜春社散，","家家扶得醉人归。"],"tags":["田园","节日","春天"],"level":2},{"title":"雨晴","author":"王驾","dynasty":"宋","lines":["雨前初见花间蕊，","雨后兼无叶底花。","蜂蝶纷纷过墙去，","却疑春色在邻家。"],"tags":["春天","花","动物"],"level":2},{"title":"春日偶成","author":"程颢","dynasty":"宋","lines":["云淡风轻近午天，","傍花随柳过前川。","时人不识余心乐，","将谓偷闲学少年。"],"tags":["春天","山水","励志"],"level":2},{"title":"秋日","author":"程颢","dynasty":"宋","lines":["闲来无事不从容，","睡觉东窗日已红。","万物静观皆自得，","四时佳兴与人同。","道通天地有形外，","思入风云变态中。","富贵不淫贫贱乐，","男儿到此是豪雄。"],"tags":["秋天","励志","山水"],"level":3},{"title":"江上渔者","author":"范仲淹","dynasty":"宋","lines":["江上往来人，","但爱鲈鱼美。","君看一叶舟，","出没风波里。"],"tags":["动物","励志"],"level":2},{"title":"客中初夏","author":"司马光","dynasty":"宋","lines":["四月清和雨乍晴，","南山当户转分明。","更无柳絮因风起，","惟有葵花向日倾。"],"tags":["夏天","植物","山水"],"level":2},{"title":"牧童诗","author":"黄庭坚","dynasty":"宋","lines":["骑牛远远过前村，","吹笛风斜隔陇闻。","多少长安名利客，","机关用尽不如君。"],"tags":["童趣","励志"],"level":2},{"title":"蚕妇","author":"张俞","dynasty":"宋","lines":["昨日入城市，","归来泪满巾。","遍身罗绮者，","不是养蚕人。"],"tags":["田园","励志"],"level":2},{"title":"雨后池上","author":"刘攽","dynasty":"宋","lines":["一雨池塘水面平，","淡磨明镜照檐楹。","东风忽起垂杨舞，","更作荷心万点声。"],"tags":["雨","夏天","山水"],"level":2},{"title":"春游湖","author":"徐俯","dynasty":"宋","lines":["双飞燕子几时回？","夹岸桃花蘸水开。","春雨断桥人不度，","小舟撑出柳阴来。"],"tags":["春天","雨","动物"],"level":2},{"title":"约客","author":"赵师秀","dynasty":"宋","lines":["黄梅时节家家雨，","青草池塘处处蛙。","有约不来过夜半，","闲敲棋子落灯花。"],"tags":["夏天","雨","动物"],"level":2},{"title":"暮春即事","author":"叶采","dynasty":"宋","lines":["双双瓦雀行书案，","点点杨花入砚池。","闲坐小窗读周易，","不知春去几多时。"],"tags":["读书","春天","童趣"],"level":2},{"title":"寒夜","author":"杜耒","dynasty":"宋","lines":["寒夜客来茶当酒，","竹炉汤沸火初红。","寻常一样窗前月，","才有梅花便不同。"],"tags":["冬天","友情","花"],"level":2},{"title":"淮中晚泊犊头","author":"苏舜钦","dynasty":"宋","lines":["春阴垂野草青青，","时有幽花一树明。","晚泊孤舟古祠下，","满川风雨看潮生。"],"tags":["春天","雨","山水"],"level":2},{"title":"画眉鸟","author":"欧阳修","dynasty":"宋","lines":["百啭千声随意移，","山花红紫树高低。","始知锁向金笼听，","不及林间自在啼。"],"tags":["动物","励志","山水"],"level":2},{"title":"丰乐亭游春","author":"欧阳修","dynasty":"宋","lines":["红树青山日欲斜，","长郊草色绿无涯。","游人不管春将老，","来往亭前踏落花。"],"tags":["春天","花","山水"],"level":2},{"title":"襄邑道中","author":"陈与义","dynasty":"宋","lines":["飞花两岸照船红，","百里榆堤半日风。","卧看满天云不动，","不知云与我俱东。"],"tags":["春天","山水","励志"],"level":2},{"title":"临平道中","author":"道潜","dynasty":"宋","lines":["风蒲猎猎弄轻柔，","欲立蜻蜓不自由。","五月临平山下路，","藕花无数满汀洲。"],"tags":["夏天","植物","山水"],"level":2},{"title":"送春","author":"王令","dynasty":"宋","lines":["三月残花落更开，","小檐日日燕飞来。","子规夜半犹啼血，","不信东风唤不回。"],"tags":["春天","动物","励志"],"level":2},{"title":"寒菊","author":"郑思肖","dynasty":"宋","lines":["花开不并百花丛，","独立疏篱趣未穷。","宁可枝头抱香死，","何曾吹落北风中。"],"tags":["冬天","花","植物"],"level":2},{"title":"立春偶成","author":"张栻","dynasty":"宋","lines":["律回岁晚冰霜少，","春到人间草木知。","便觉眼前生意满，","东风吹水绿参差。"],"tags":["春天","冬天","励志"],"level":2},{"title":"立秋","author":"刘翰","dynasty":"宋","lines":["乳鸦啼散玉屏空，","一枕新凉一扇风。","睡起秋声无觅处，","满阶梧叶月明中。"],"tags":["秋天","时间","月亮"],"level":2},{"title":"江南春","author":"寇准","dynasty":"宋","lines":["波渺渺，","柳依依。","孤村芳草远，","斜日杏花飞。"],"tags":["春天","山水","思乡"],"level":1},{"title":"清明","author":"王禹偁","dynasty":"宋","lines":["无花无酒过清明，","兴味萧然似野僧。","昨日邻家乞新火，","晓窗分与读书灯。"],"tags":["春天","读书","节日"],"level":2},{"title":"陶者","author":"梅尧臣","dynasty":"宋","lines":["陶尽门前土，","屋上无片瓦。","十指不沾泥，","鳞鳞居大厦。"],"tags":["励志","田园"],"level":2},{"title":"咏柳","author":"曾巩","dynasty":"宋","lines":["乱条犹未变初黄，","倚得东风势便狂。","解把飞花蒙日月，","不知天地有清霜。"],"tags":["春天","植物","励志"],"level":2},{"title":"夜书所见","author":"叶绍翁","dynasty":"宋","lines":["萧萧梧叶送寒声，","江上秋风动客情。","知有儿童挑促织，","夜深篱落一灯明。"],"tags":["秋天","思乡","童趣"],"level":2},{"title":"春日","author":"秦观","dynasty":"宋","lines":["一夕轻雷落万丝，","霁光浮瓦碧参差。","有情芍药含春泪，","无力蔷薇卧晓枝。"],"tags":["春天","雨","花"],"level":2},{"title":"卜算子·送鲍浩然之浙东","author":"王观","dynasty":"宋","lines":["水是眼波横，","山是眉峰聚。","欲问行人去那边，","眉眼盈盈处。","才始送春归，","又送君归去。","若到江南赶上春，","千万和春住。"],"tags":["送别","春天","山水"],"level":2},{"title":"数日","author":"赵师秀","dynasty":"宋","lines":["数日秋风欺病夫，","尽吹黄叶下庭芜。","林疏放得遥山出，","又被云遮一半无。"],"tags":["秋天","山水"],"level":2},{"title":"关雎","author":"佚名","dynasty":"先秦","lines":["关关雎鸠，","在河之洲。","窈窕淑女，","君子好逑。"],"tags":["动物","植物"],"level":2},{"title":"蒹葭","author":"佚名","dynasty":"先秦","lines":["蒹葭苍苍，","白露为霜。","所谓伊人，","在水一方。"],"tags":["植物","秋天"],"level":2},{"title":"木瓜","author":"佚名","dynasty":"先秦","lines":["投我以木瓜，","报之以琼琚。","匪报也，","永以为好也。"],"tags":["植物","友情"],"level":2},{"title":"采薇","author":"佚名","dynasty":"先秦","lines":["昔我往矣，","杨柳依依。","今我来思，","雨雪霏霏。"],"tags":["冬天","边塞"],"level":3},{"title":"桃夭","author":"佚名","dynasty":"先秦","lines":["桃之夭夭，","灼灼其华。","之子于归，","宜其室家。"],"tags":["花","春天"],"level":2},{"title":"静女","author":"佚名","dynasty":"先秦","lines":["静女其姝，","俟我于城隅。","爱而不见，","搔首踟蹰。"],"tags":["春天","植物"],"level":2},{"title":"硕鼠","author":"佚名","dynasty":"先秦","lines":["硕鼠硕鼠，","无食我黍！","三岁贯女，","莫我肯顾。"],"tags":["动物","励志"],"level":2},{"title":"无衣","author":"佚名","dynasty":"先秦","lines":["岂曰无衣？","与子同袍。","王于兴师，","修我戈矛。"],"tags":["友情","边塞"],"level":3},{"title":"子衿","author":"佚名","dynasty":"先秦","lines":["青青子衿，","悠悠我心。","纵我不往，","子宁不嗣音？"],"tags":["友情","春天"],"level":2},{"title":"鹿鸣","author":"佚名","dynasty":"先秦","lines":["呦呦鹿鸣，","食野之苹。","我有嘉宾，","鼓瑟吹笙。"],"tags":["动物","友情"],"level":2},{"title":"采葛","author":"佚名","dynasty":"先秦","lines":["彼采葛兮，","一日不见，","如三月兮。"],"tags":["友情","植物"],"level":1},{"title":"月出","author":"佚名","dynasty":"先秦","lines":["月出皎兮，","佼人僚兮。","舒窈纠兮，","劳心悄兮。"],"tags":["月亮","秋天"],"level":3},{"title":"式微","author":"佚名","dynasty":"先秦","lines":["式微式微，","胡不归？","微君之故，","胡为乎中露？"],"tags":["思乡","励志"],"level":2},{"title":"芣苢","author":"佚名","dynasty":"先秦","lines":["采采芣苢，","薄言采之。","采采芣苢，","薄言有之。"],"tags":["植物","田园"],"level":1},{"title":"凯风","author":"佚名","dynasty":"先秦","lines":["凯风自南，","吹彼棘心。","棘心夭夭，","母氏劬劳。"],"tags":["母爱","夏天"],"level":2},{"title":"野有蔓草","author":"佚名","dynasty":"先秦","lines":["野有蔓草，","零露漙兮。","有美一人，","清扬婉兮。"],"tags":["春天","植物"],"level":2},{"title":"黍离","author":"佚名","dynasty":"先秦","lines":["彼黍离离，","彼稷之苗。","行迈靡靡，","中心摇摇。"],"tags":["田园","思乡"],"level":3},{"title":"君子于役","author":"佚名","dynasty":"先秦","lines":["君子于役，","不知其期。","曷至哉？","鸡栖于埘。"],"tags":["思乡","动物"],"level":2},{"title":"离骚","author":"屈原","dynasty":"先秦","lines":["路漫漫其修远兮，","吾将上下而求索。"],"tags":["励志","山水"],"level":3},{"title":"橘颂","author":"屈原","dynasty":"先秦","lines":["后皇嘉树，","橘徕服兮。","受命不迁，","生南国兮。"],"tags":["植物","励志"],"level":3},{"title":"长歌行","author":"佚名","dynasty":"汉","lines":["青青园中葵，","朝露待日晞。","阳春布德泽，","万物生光辉。","少壮不努力，","老大徒伤悲。"],"tags":["时间","励志"],"level":2},{"title":"大风歌","author":"刘邦","dynasty":"汉","lines":["大风起兮云飞扬，","威加海内兮归故乡，","安得猛士兮守四方！"],"tags":["励志","边塞"],"level":2},{"title":"垓下歌","author":"项羽","dynasty":"汉","lines":["力拔山兮气盖世，","时不利兮骓不逝。","骓不逝兮可奈何，","虞兮虞兮奈若何！"],"tags":["励志","边塞"],"level":3},{"title":"上邪","author":"佚名","dynasty":"汉","lines":["上邪！","我欲与君相知，","长命无绝衰。"],"tags":["友情","冬天"],"level":2},{"title":"陌上桑","author":"佚名","dynasty":"汉","lines":["日出东南隅，","照我秦氏楼。","秦氏有好女，","自名为罗敷。"],"tags":["田园","夏天"],"level":2},{"title":"十五从军征","author":"佚名","dynasty":"汉","lines":["十五从军征，","八十始得归。","道逢乡里人，","家中有阿谁？"],"tags":["思乡","边塞"],"level":3},{"title":"李延年歌","author":"李延年","dynasty":"汉","lines":["北方有佳人，","绝世而独立。","一顾倾人城，","再顾倾人国。"],"tags":["友情","励志"],"level":2},{"title":"秋风辞","author":"刘彻","dynasty":"汉","lines":["秋风起兮白云飞，","草木黄落兮雁南归。","兰有秀兮菊有芳，","怀佳人兮不能忘。"],"tags":["秋天","动物"],"level":3},{"title":"涉江采芙蓉","author":"佚名","dynasty":"汉","lines":["涉江采芙蓉，","兰泽多芳草。","采之欲遗谁？","所思在远道。"],"tags":["植物","思乡"],"level":2},{"title":"迢迢牵牛星","author":"佚名","dynasty":"汉","lines":["迢迢牵牛星，","皎皎河汉女。","盈盈一水间，","脉脉不得语。"],"tags":["月亮","友情"],"level":3},{"title":"行行重行行","author":"佚名","dynasty":"汉","lines":["行行重行行，","与君生别离。","相去万余里，","各在天一涯。"],"tags":["思乡","友情"],"level":3},{"title":"观沧海","author":"曹操","dynasty":"魏晋","lines":["东临碣石，","以观沧海。","水何澹澹，","山岛竦峙。","树木丛生，","百草丰茂。","秋风萧瑟，","洪波涌起。"],"tags":["山水","秋天"],"level":3},{"title":"龟虽寿","author":"曹操","dynasty":"魏晋","lines":["老骥伏枥，","志在千里。","烈士暮年，","壮心不已。"],"tags":["励志","动物"],"level":3},{"title":"短歌行","author":"曹操","dynasty":"魏晋","lines":["对酒当歌，","人生几何！","譬如朝露，","去日苦多。"],"tags":["时间","友情"],"level":3},{"title":"饮酒","author":"陶渊明","dynasty":"魏晋","lines":["结庐在人境，","而无车马喧。","问君何能尔，","心远地自偏。","采菊东篱下，","悠然见南山。","山气日夕佳，","飞鸟相与还。"],"tags":["植物","田园"],"level":3},{"title":"归园田居","author":"陶渊明","dynasty":"魏晋","lines":["种豆南山下，","草盛豆苗稀。","晨兴理荒秽，","带月荷锄归。"],"tags":["田园","月亮"],"level":2},{"title":"杂诗","author":"陶渊明","dynasty":"魏晋","lines":["盛年不重来，","一日难再晨。","及时当勉励，","岁月不待人。"],"tags":["时间","励志"],"level":2},{"title":"赠范晔","author":"陆凯","dynasty":"魏晋","lines":["折花逢驿使，","寄与陇头人。","江南无所有，","聊赠一枝春。"],"tags":["友情","植物"],"level":2},{"title":"咏雪","author":"谢道韫","dynasty":"魏晋","lines":["白雪纷纷何所似？","未若柳絮因风起。"],"tags":["雪","冬天"],"level":2},{"title":"思吴江歌","author":"张翰","dynasty":"魏晋","lines":["秋风起兮木叶飞，","吴江水兮鲈正肥。","三千里兮家未归，","恨难禁兮仰天悲。"],"tags":["秋天","思乡"],"level":3},{"title":"燕歌行","author":"曹丕","dynasty":"魏晋","lines":["秋风萧瑟天气凉，","草木摇落露为霜。","群燕辞归鹄南翔，","念君客游思断肠。"],"tags":["秋天","思乡"],"level":3},{"title":"木兰诗","author":"佚名","dynasty":"南北朝","lines":["唧唧复唧唧，","木兰当户织。","不闻机杼声，","惟闻女叹息。"],"tags":["动物","励志"],"level":2},{"title":"西洲曲","author":"佚名","dynasty":"南北朝","lines":["采莲南塘秋，","莲花过人头。","低头弄莲子，","莲子清如水。"],"tags":["植物","秋天"],"level":3},{"title":"子夜歌","author":"佚名","dynasty":"南北朝","lines":["始欲识郎时，","两心望如一。","理丝入残机，","何悟不成匹。"],"tags":["友情","植物"],"level":2},{"title":"华山畿","author":"佚名","dynasty":"南北朝","lines":["君既为侬死，","独活为谁施？","欢若见怜时，","棺木为侬开。"],"tags":["友情","励志"],"level":3},{"title":"陇头歌辞","author":"佚名","dynasty":"南北朝","lines":["陇头流水，","流离山下。","念吾一身，","飘然旷野。"],"tags":["山水","思乡"],"level":3},{"title":"折杨柳歌辞","author":"佚名","dynasty":"南北朝","lines":["健儿须快马，","快马须健儿。","跸跋黄尘下，","然后别雄雌。"],"tags":["边塞","动物"],"level":3},{"title":"玉树后庭花","author":"陈叔宝","dynasty":"南北朝","lines":["丽宇芳林对高阁，","新妆艳质本倾城。","映户凝娇乍不进，","出帷含态笑相迎。"],"tags":["花","友情"],"level":3},{"title":"企喻歌","author":"佚名","dynasty":"南北朝","lines":["男儿欲作健，","结伴不须多。","鹞子经天飞，","群雀两向波。"],"tags":["边塞","动物"],"level":2},{"title":"人日思归","author":"薛道衡","dynasty":"隋","lines":["入春才七日，","离家已二年。","人归落雁后，","思发在花前。"],"tags":["思乡","春天"],"level":2},{"title":"送别","author":"佚名","dynasty":"隋","lines":["杨柳青青著地垂，","杨花漫漫搅天飞。","柳条折尽花飞尽，","借问行人归不归。"],"tags":["送别","春天"],"level":2},{"title":"天净沙·秋思","author":"马致远","dynasty":"元","lines":["枯藤老树昏鸦，","小桥流水人家，","古道西风瘦马。","夕阳西下，","断肠人在天涯。"],"tags":["秋天","思乡"],"level":2},{"title":"天净沙·秋","author":"白朴","dynasty":"元","lines":["孤村落日残霞，","轻烟老树寒鸦，","一点飞鸿影下。","青山绿水，","白草红叶黄花。"],"tags":["秋天","山水"],"level":2},{"title":"山坡羊·潼关怀古","author":"张养浩","dynasty":"元","lines":["峰峦如聚，","波涛如怒，","山河表里潼关路。","望西都，","意踌躇。"],"tags":["山水","边塞"],"level":3},{"title":"沉醉东风·渔父","author":"白朴","dynasty":"元","lines":["黄芦岸白蘋渡口，","绿杨堤红蓼滩头。","虽无刎颈交，","却有忘机友。"],"tags":["山水","友情"],"level":3},{"title":"清江引·秋居","author":"吴西逸","dynasty":"元","lines":["白雁乱飞秋似雪，","清露生凉夜。","扫却石边云，","醉踏松根月。"],"tags":["秋天","月亮"],"level":3},{"title":"水仙子·夜雨","author":"徐再思","dynasty":"元","lines":["一声梧叶一声秋，","一点芭蕉一点愁，","三更归梦三更后。"],"tags":["秋天","思乡"],"level":3},{"title":"寿阳曲·江天暮雪","author":"马致远","dynasty":"元","lines":["天将暮，","雪乱舞，","半梅花半飘柳絮。","江上晚来堪画处，","钓鱼人一蓑归去。"],"tags":["雪","冬天"],"level":3},{"title":"凭栏人·寄征衣","author":"姚燧","dynasty":"元","lines":["欲寄君衣君不还，","不寄君衣君又寒。","寄与不寄间，","妾身千万难。"],"tags":["思乡","冬天"],"level":3},{"title":"画鸡","author":"唐寅","dynasty":"明","lines":["头上红冠不用裁，","满身雪白走将来。","平生不敢轻言语，","一叫千门万户开。"],"tags":["动物","励志"],"level":2},{"title":"明日歌","author":"钱福","dynasty":"明","lines":["明日复明日，","明日何其多。","我生待明日，","万事成蹉跎。"],"tags":["时间","励志"],"level":2},{"title":"言志","author":"唐寅","dynasty":"明","lines":["不炼金丹不坐禅，","不为商贾不耕田。","闲来写就青山卖，","不使人间造孽钱。"],"tags":["山水","励志"],"level":3},{"title":"马上作","author":"戚继光","dynasty":"明","lines":["南北驱驰报主情，","江花边草笑平生。","一年三百六十日，","多是横戈马上行。"],"tags":["边塞","励志"],"level":3},{"title":"就义诗","author":"杨继盛","dynasty":"明","lines":["浩气还太虚，","丹心照千古。","生平未报国，","留作忠魂补。"],"tags":["励志","边塞"],"level":3},{"title":"临江仙·滚滚长江东逝水","author":"杨慎","dynasty":"明","lines":["滚滚长江东逝水，","浪花淘尽英雄。","是非成败转头空。"],"tags":["时间","山水"],"level":3},{"title":"春雁","author":"王恭","dynasty":"明","lines":["春风一夜到衡阳，","楚水燕山万里长。","莫道春来便归去，","江南虽好是他乡。"],"tags":["动物","思乡"],"level":3},{"title":"苔","author":"袁枚","dynasty":"清","lines":["白日不到处，","青春恰自来。","苔花如米小，","也学牡丹开。"],"tags":["植物","励志"],"level":2},{"title":"十二月十五夜","author":"袁枚","dynasty":"清","lines":["沉沉更鼓急，","渐渐人声绝。","吹灯窗更明，","月照一天雪。"],"tags":["冬天","月亮"],"level":2},{"title":"咏雪","author":"郑燮","dynasty":"清","lines":["一片两片三四片，","五六七八九十片。","千片万片无数片，","飞入梅花都不见。"],"tags":["雪","冬天"],"level":2},{"title":"己亥杂诗·其二百二十","author":"龚自珍","dynasty":"清","lines":["九州生气恃风雷，","万马齐喑究可哀。","我劝天公重抖擞，","不拘一格降人才。"],"tags":["励志","边塞"],"level":2},{"title":"长相思·山一程","author":"纳兰性德","dynasty":"清","lines":["山一程，","水一程，","身向榆关那畔行，","夜深千帐灯。"],"tags":["思乡","山水"],"level":2},{"title":"对酒","author":"秋瑾","dynasty":"清","lines":["不惜千金买宝刀，","貂裘换酒也堪豪。","一腔热血勤珍重，","洒去犹能化碧涛。"],"tags":["励志","边塞"],"level":3},{"title":"春愁","author":"丘逢甲","dynasty":"清","lines":["春愁难遣强看山，","往事惊心泪欲潸。","四百万人同一哭，","去年今日割台湾。"],"tags":["思乡","春天"],"level":3},{"title":"出塞","author":"徐锡麟","dynasty":"清","lines":["军歌应唱大刀环，","誓灭胡奴出玉关。","只解沙场为国死，","何须马革裹尸还。"],"tags":["边塞","励志"],"level":3},{"title":"狱中题壁","author":"谭嗣同","dynasty":"清","lines":["望门投止思张俭，","忍死须臾待杜根。","我自横刀向天笑，","去留肝胆两昆仑。"],"tags":["励志","边塞"],"level":3},{"title":"题秋江独钓图","author":"王士祯","dynasty":"清","lines":["一蓑一笠一扁舟，","一丈丝纶一寸钩。","一曲高歌一樽酒，","一人独钓一江秋。"],"tags":["秋天","山水"],"level":2},{"title":"癸巳除夕偶成","author":"黄景仁","dynasty":"清","lines":["千家笑语漏迟迟，","忧患潜从物外知。","悄立市桥人不识，","一星如月看多时。"],"tags":["冬天","思乡"],"level":3},{"title":"赠梁任父同年","author":"黄遵宪","dynasty":"清","lines":["寸寸山河寸寸金，","侉离分裂力谁任。","杜鹃再拜忧天泪，","精卫无穷填海心。"],"tags":["边塞","励志"],"level":3},{"title":"漫感","author":"龚自珍","dynasty":"清","lines":["绝域从军计惘然，","东南幽恨满词笺。","一箫一剑平生意，","负尽狂名十五年。"],"tags":["边塞","励志"],"level":3},{"title":"岁暮到家","author":"蒋士铨","dynasty":"清","lines":["爱子心无尽，","归家喜及辰。","寒衣针线密，","家信墨痕新。"],"tags":["母爱","冬天"],"level":2},{"title":"新雷","author":"张维屏","dynasty":"清","lines":["造物无言却有情，","每于寒尽觉春生。","千红万紫安排著，","只待新雷第一声。"],"tags":["春天","励志"],"level":2},{"title":"绝句漫兴","author":"杜甫","dynasty":"唐","lines":["糁径杨花铺白毡，","点溪荷叶叠青钱。","笋根雉子无人见，","沙上凫雏傍母眠。"],"tags":["夏天","动物","田园"],"level":3},{"title":"山中送别","author":"王维","dynasty":"唐","lines":["山中相送罢，","日暮掩柴扉。","春草明年绿，","王孙归不归。"],"tags":["送别","春天","友情"],"level":1},{"title":"画","author":"王维","dynasty":"唐","lines":["远看山有色，","近听水无声。","春去花还在，","人来鸟不惊。"],"tags":["山水","童趣","花"],"level":1},{"title":"商山早行","author":"温庭筠","dynasty":"唐","lines":["晨起动征铎，","客行悲故乡。","鸡声茅店月，","人迹板桥霜。","槲叶落山路，","枳花明驿墙。","因思杜陵梦，","凫雁满回塘。"],"tags":["思乡","秋天","月亮"],"level":3},{"title":"宫词","author":"张祜","dynasty":"唐","lines":["故国三千里，","深宫二十年。","一声何满子，","双泪落君前。"],"tags":["思乡","时间"],"level":2},{"title":"题金陵渡","author":"张祜","dynasty":"唐","lines":["金陵津渡小山楼，","一宿行人自可愁。","潮落夜江斜月里，","两三星火是瓜洲。"],"tags":["月亮","思乡","山水"],"level":2},{"title":"题都城南庄","author":"崔护","dynasty":"唐","lines":["去年今日此门中，","人面桃花相映红。","人面不知何处去，","桃花依旧笑春风。"],"tags":["春天","花","时间"],"level":2},{"title":"十五夜望月","author":"王建","dynasty":"唐","lines":["中庭地白树栖鸦，","冷露无声湿桂花。","今夜月明人尽望，","不知秋思落谁家。"],"tags":["月亮","秋天","节日"],"level":2},{"title":"雨过山村","author":"王建","dynasty":"唐","lines":["雨里鸡鸣一两家，","竹溪村路板桥斜。","妇姑相唤浴蚕去，","闲看中庭栀子花。"],"tags":["田园","雨","花"],"level":2},{"title":"晚春","author":"韩愈","dynasty":"唐","lines":["草树知春不久归，","百般红紫斗芳菲。","杨花榆荚无才思，","惟解漫天作雪飞。"],"tags":["春天","花","植物"],"level":2},{"title":"早春呈水部张十八员外","author":"韩愈","dynasty":"唐","lines":["天街小雨润如酥，","草色遥看近却无。","最是一年春好处，","绝胜烟柳满皇都。"],"tags":["春天","雨","植物"],"level":2},{"title":"菊花","author":"元稹","dynasty":"唐","lines":["秋丛绕舍似陶家，","遍绕篱边日渐斜。","不是花中偏爱菊，","此花开尽更无花。"],"tags":["秋天","花","植物"],"level":2},{"title":"马诗","author":"李贺","dynasty":"唐","lines":["大漠沙如雪，","燕山月似钩。","何当金络脑，","快走踏清秋。"],"tags":["动物","励志","边塞"],"level":2},{"title":"长干行","author":"崔颢","dynasty":"唐","lines":["君家何处住，","妾住在横塘。","停船暂借问，","或恐是同乡。"],"tags":["思乡","友情"],"level":1},{"title":"渔歌子","author":"张志和","dynasty":"唐","lines":["西塞山前白鹭飞，","桃花流水鳜鱼肥。","青箬笠，","绿蓑衣，","斜风细雨不须归。"],"tags":["山水","田园","雨"],"level":2},{"title":"相见欢·无言独上西楼","author":"李煜","dynasty":"唐","lines":["无言独上西楼，","月如钩。","寂寞梧桐深院锁清秋。","剪不断，","理还乱，","是离愁。","别是一般滋味在心头。"],"tags":["月亮","秋天","思乡"],"level":3},{"title":"浣溪沙·一曲新词酒一杯","author":"晏殊","dynasty":"宋","lines":["一曲新词酒一杯，","去年天气旧亭台。","夕阳西下几时回？","无可奈何花落去，","似曾相识燕归来。","小园香径独徘徊。"],"tags":["时间","春天","花"],"level":3},{"title":"浣溪沙·山下兰芽短浸溪","author":"苏轼","dynasty":"宋","lines":["山下兰芽短浸溪，","松间沙路净无泥。","萧萧暮雨子规啼。","谁道人生无再少？","门前流水尚能西！","休将白发唱黄鸡。"],"tags":["励志","山水","雨"],"level":3},{"title":"秋思","author":"张籍","dynasty":"唐","lines":["洛阳城里见秋风，","欲作家书意万重。","复恐匆匆说不尽，","行人临发又开封。"],"tags":["思乡","秋天"],"level":2},{"title":"春怨","author":"金昌绪","dynasty":"唐","lines":["打起黄莺儿，","莫教枝上啼。","啼时惊妾梦，","不得到辽西。"],"tags":["春天","动物","思乡"],"level":2},{"title":"登幽州台歌","author":"陈子昂","dynasty":"唐","lines":["前不见古人，","后不见来者。","念天地之悠悠，","独怆然而涕下。"],"tags":["时间","励志"],"level":2},{"title":"于易水送人","author":"骆宾王","dynasty":"唐","lines":["此地别燕丹，","壮士发冲冠。","昔时人已没，","今日水犹寒。"],"tags":["送别","友情","励志"],"level":2},{"title":"送杜少府之任蜀州","author":"王勃","dynasty":"唐","lines":["城阙辅三秦，","风烟望五津。","与君离别意，","同是宦游人。","海内存知己，","天涯若比邻。","无为在歧路，","儿女共沾巾。"],"tags":["送别","友情","励志"],"level":3},{"title":"望岳","author":"杜甫","dynasty":"唐","lines":["岱宗夫如何？","齐鲁青未了。","造化钟神秀，","阴阳割昏晓。","荡胸生曾云，","决眦入归鸟。","会当凌绝顶，","一览众山小。"],"tags":["山水","励志"],"level":3},{"title":"月夜忆舍弟","author":"杜甫","dynasty":"唐","lines":["戍鼓断人行，","边秋一雁声。","露从今夜白，","月是故乡明。","有弟皆分散，","无家问死生。","寄书长不达，","况乃未休兵。"],"tags":["思乡","月亮","秋天"],"level":3},{"title":"山亭夏日","author":"高骈","dynasty":"唐","lines":["绿树阴浓夏日长，","楼台倒影入池塘。","水晶帘动微风起，","满架蔷薇一院香。"],"tags":["夏天","花","田园"],"level":2},{"title":"城东早春","author":"杨巨源","dynasty":"唐","lines":["诗家清景在新春，","绿柳才黄半未匀。","若待上林花似锦，","出门俱是看花人。"],"tags":["春天","植物","花"],"level":2},{"title":"江村即事","author":"司空曙","dynasty":"唐","lines":["钓罢归来不系船，","江村月落正堪眠。","纵然一夜风吹去，","只在芦花浅水边。"],"tags":["田园","月亮","山水"],"level":2},{"title":"村夜","author":"白居易","dynasty":"唐","lines":["霜草苍苍虫切切，","村南村北行人绝。","独出前门望野田，","月明荞麦花如雪。"],"tags":["月亮","田园","秋天"],"level":2},{"title":"鸟","author":"白居易","dynasty":"唐","lines":["谁道群生性命微，","一般骨肉一般皮。","劝君莫打枝头鸟，","子在巢中望母归。"],"tags":["动物","母爱"],"level":1},{"title":"夜雪","author":"白居易","dynasty":"唐","lines":["已讶衾枕冷，","复见窗户明。","夜深知雪重，","时闻折竹声。"],"tags":["冬天","雪"],"level":1},{"title":"白云泉","author":"白居易","dynasty":"唐","lines":["天平山上白云泉，","云自无心水自闲。","何必奔冲山下去，","更添波浪向人间。"],"tags":["山水","田园"],"level":2},{"title":"生查子·元夕","author":"欧阳修","dynasty":"宋","lines":["去年元夜时，","花市灯如昼。","月上柳梢头，","人约黄昏后。","今年元夜时，","月与灯依旧。","不见去年人，","泪湿春衫袖。"],"tags":["节日","月亮","时间"],"level":2},{"title":"卜算子·我住长江头","author":"李之仪","dynasty":"宋","lines":["我住长江头，","君住长江尾。","日日思君不见君，","共饮长江水。","此水几时休，","此恨何时已。","只愿君心似我心，","定不负相思意。"],"tags":["思乡","山水","友情"],"level":2},{"title":"卜算子·咏梅","author":"陆游","dynasty":"宋","lines":["驿外断桥边，","寂寞开无主。","已是黄昏独自愁，","更著风和雨。","无意苦争春，","一任群芳妒。","零落成泥碾作尘，","只有香如故。"],"tags":["冬天","花","励志"],"level":3},{"title":"山村咏怀","author":"邵雍","dynasty":"宋","lines":["一去二三里，","烟村四五家。","亭台六七座，","八九十枝花。"],"tags":["童趣","田园","花"],"level":1},{"title":"桂源铺","author":"杨万里","dynasty":"宋","lines":["万山不许一溪奔，","拦得溪声日夜喧。","到得前头山脚尽，","堂堂溪水出前村。"],"tags":["山水","励志"],"level":2},{"title":"北陂杏花","author":"王安石","dynasty":"宋","lines":["一陂春水绕花身，","花影妖娆各占春。","纵被春风吹作雪，","绝胜南陌碾成尘。"],"tags":["春天","花"],"level":3},{"title":"春夜","author":"王安石","dynasty":"宋","lines":["金炉香烬漏声残，","翦翦轻风阵阵寒。","春色恼人眠不得，","月移花影上栏干。"],"tags":["春天","月亮","花"],"level":3},{"title":"鄂州南楼书事","author":"黄庭坚","dynasty":"宋","lines":["四顾山光接水光，","凭栏十里芰荷香。","清风明月无人管，","并作南楼一味凉。"],"tags":["夏天","山水","月亮"],"level":2},{"title":"初夏游张园","author":"戴复古","dynasty":"宋","lines":["乳鸭池塘水浅深，","熟梅天气半晴阴。","东园载酒西园醉，","摘尽枇杷一树金。"],"tags":["夏天","田园","植物"],"level":2},{"title":"即景","author":"朱淑真","dynasty":"宋","lines":["竹摇清影罩幽窗，","两两时禽噪夕阳。","谢却海棠飞尽絮，","困人天气日初长。"],"tags":["夏天","植物"],"level":3},{"title":"咏华山","author":"寇准","dynasty":"宋","lines":["只有天在上，","更无山与齐。","举头红日近，","回首白云低。"],"tags":["山水","童趣"],"level":1},{"title":"喜晴","author":"范成大","dynasty":"宋","lines":["窗间梅熟落蒂，","墙下笋成出林。","连雨不知春去，","一晴方觉夏深。"],"tags":["夏天","田园","雨"],"level":2},{"title":"初秋行圃","author":"杨万里","dynasty":"宋","lines":["落日无情最有情，","遍催万树暮蝉鸣。","听来咫尺无寻处，","寻到旁边却不声。"],"tags":["秋天","童趣","动物"],"level":2},{"title":"梅花绝句","author":"陆游","dynasty":"宋","lines":["闻道梅花坼晓风，","雪堆遍满四山中。","何方可化身千亿，","一树梅花一放翁。"],"tags":["冬天","花","雪"],"level":3},{"title":"乡思","author":"李觏","dynasty":"宋","lines":["人言落日是天涯，","望极天涯不见家。","已恨碧山相阻隔，","碧山还被暮云遮。"],"tags":["思乡","山水"],"level":2},{"title":"三月晦日偶题","author":"秦观","dynasty":"宋","lines":["节物相催各自新，","痴心儿女挽留春。","芳菲歇去何须恨，","夏木阴阴正可人。"],"tags":["春天","夏天","时间"],"level":3},{"title":"乙卯重五诗","author":"陆游","dynasty":"宋","lines":["重五山村好，","榴花忽已繁。","粽包分两髻，","艾束著危冠。","旧俗方储药，","羸躯亦点丹。","日斜吾事毕，","一笑向杯盘。"],"tags":["节日","田园"],"level":3},{"title":"神童诗·劝学","author":"汪洙","dynasty":"宋","lines":["天子重英豪，","文章教尔曹。","万般皆下品，","惟有读书高。"],"tags":["读书","励志"],"level":1},{"title":"神童诗·四季","author":"汪洙","dynasty":"宋","lines":["春游芳草地，","夏赏绿荷池。","秋饮黄花酒，","冬吟白雪诗。"],"tags":["时间","春天","冬天"],"level":1},{"title":"断句","author":"苏麟","dynasty":"宋","lines":["近水楼台先得月，","向阳花木易为春。"],"tags":["月亮","春天","植物"],"level":2},{"title":"立春","author":"白玉蟾","dynasty":"宋","lines":["东风吹散梅梢雪，","一夜挽回天下春。","从此阳春应有脚，","百花富贵草精神。"],"tags":["春天","节日","雪"],"level":3},{"title":"中秋登楼望月","author":"米芾","dynasty":"宋","lines":["目穷淮海满如银，","万道虹光育蚌珍。","天上若无修月户，","桂枝撑损向西轮。"],"tags":["月亮","节日"],"level":3},{"title":"寻胡隐君","author":"高启","dynasty":"明","lines":["渡水复渡水，","看花还看花。","春风江上路，","不觉到君家。"],"tags":["春天","友情","花"],"level":1},{"title":"牧牛词","author":"高启","dynasty":"明","lines":["尔牛角弯环，","我牛尾秃速。","共拈短笛与长鞭，","南陇东冈去相逐。"],"tags":["童趣","田园","动物"],"level":2},{"title":"天平山中","author":"杨基","dynasty":"明","lines":["细雨茸茸湿楝花，","南风树树熟枇杷。","徐行不记山深浅，","一路莺啼送到家。"],"tags":["山水","夏天","雨"],"level":2},{"title":"京师得家书","author":"袁凯","dynasty":"明","lines":["江水三千里，","家书十五行。","行行无别语，","只道早还乡。"],"tags":["思乡","山水"],"level":1},{"title":"蔽月山房","author":"王守仁","dynasty":"明","lines":["山近月远觉月小，","便道此山大于月。","若人有眼大如天，","当见山小月更阔。"],"tags":["月亮","童趣","山水"],"level":2},{"title":"咏兰花","author":"张羽","dynasty":"明","lines":["能白更兼黄，","无人亦自芳。","寸心原不大，","容得许多香。"],"tags":["植物","励志","花"],"level":1},{"title":"除夜太原寒甚","author":"于谦","dynasty":"明","lines":["寄语天涯客，","轻寒底用愁。","春风来不远，","只在屋东头。"],"tags":["节日","春天","冬天"],"level":2},{"title":"九日","author":"文森","dynasty":"明","lines":["三载重阳菊，","开时不在家。","何期今日酒，","忽对故园花。"],"tags":["节日","思乡","花"],"level":2},{"title":"山中雪后","author":"郑燮","dynasty":"清","lines":["晨起开门雪满山，","雪晴云淡日光寒。","檐流未滴梅花冻，","一种清孤不等闲。"],"tags":["雪","冬天","花"],"level":3},{"title":"推窗","author":"袁枚","dynasty":"清","lines":["连宵风雨恶，","蓬户不轻开。","山似相思久，","推窗扑面来。"],"tags":["山水","雨"],"level":2},{"title":"真州绝句","author":"王士祯","dynasty":"清","lines":["江干多是钓人居，","柳陌菱塘一带疏。","好是日斜风定后，","半江红树卖鲈鱼。"],"tags":["山水","秋天","田园"],"level":3},{"title":"野步","author":"赵翼","dynasty":"清","lines":["峭寒催换木棉裘，","倚杖郊原作近游。","最是秋风管闲事，","红他枫叶白人头。"],"tags":["秋天","时间"],"level":3},{"title":"潍县署中画竹","author":"郑燮","dynasty":"清","lines":["衙斋卧听萧萧竹，","疑是民间疾苦声。","些小吾曹州县吏，","一枝一叶总关情。"],"tags":["植物","励志"],"level":3},{"title":"湖上杂诗","author":"袁枚","dynasty":"清","lines":["葛岭花开二月天，","游人来往说神仙。","老夫心与游人异，","不羡神仙羡少年。"],"tags":["春天","时间","花"],"level":3},{"title":"甲午元旦","author":"孔尚任","dynasty":"清","lines":["萧疏白发不盈颠，","守岁围炉竟废眠。","剪烛催干消夜酒，","倾囊分遍买春钱。"],"tags":["节日","冬天","时间"],"level":3}]