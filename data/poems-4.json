[
  {
    "title": "关雎",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["关关雎鸠，", "在河之洲。", "窈窕淑女，", "君子好逑。"],
    "tags": ["动物", "植物"],
    "level": 2
  },
  {
    "title": "蒹葭",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["蒹葭苍苍，", "白露为霜。", "所谓伊人，", "在水一方。"],
    "tags": ["植物", "秋天"],
    "level": 2
  },
  {
    "title": "木瓜",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["投我以木瓜，", "报之以琼琚。", "匪报也，", "永以为好也。"],
    "tags": ["植物", "友情"],
    "level": 2
  },
  {
    "title": "采薇",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["昔我往矣，", "杨柳依依。", "今我来思，", "雨雪霏霏。"],
    "tags": ["冬天", "边塞"],
    "level": 3
  },
  {
    "title": "桃夭",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["桃之夭夭，", "灼灼其华。", "之子于归，", "宜其室家。"],
    "tags": ["花", "春天"],
    "level": 2
  },
  {
    "title": "静女",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["静女其姝，", "俟我于城隅。", "爱而不见，", "搔首踟蹰。"],
    "tags": ["春天", "植物"],
    "level": 2
  },
  {
    "title": "硕鼠",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["硕鼠硕鼠，", "无食我黍！", "三岁贯女，", "莫我肯顾。"],
    "tags": ["动物", "励志"],
    "level": 2
  },
  {
    "title": "无衣",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["岂曰无衣？", "与子同袍。", "王于兴师，", "修我戈矛。"],
    "tags": ["友情", "边塞"],
    "level": 3
  },
  {
    "title": "子衿",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["青青子衿，", "悠悠我心。", "纵我不往，", "子宁不嗣音？"],
    "tags": ["友情", "春天"],
    "level": 2
  },
  {
    "title": "鹿鸣",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["呦呦鹿鸣，", "食野之苹。", "我有嘉宾，", "鼓瑟吹笙。"],
    "tags": ["动物", "友情"],
    "level": 2
  },
  {
    "title": "采葛",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["彼采葛兮，", "一日不见，", "如三月兮。"],
    "tags": ["友情", "植物"],
    "level": 1
  },
  {
    "title": "月出",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["月出皎兮，", "佼人僚兮。", "舒窈纠兮，", "劳心悄兮。"],
    "tags": ["月亮", "秋天"],
    "level": 3
  },
  {
    "title": "式微",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["式微式微，", "胡不归？", "微君之故，", "胡为乎中露？"],
    "tags": ["思乡", "励志"],
    "level": 2
  },
  {
    "title": "芣苢",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["采采芣苢，", "薄言采之。", "采采芣苢，", "薄言有之。"],
    "tags": ["植物", "田园"],
    "level": 1
  },
  {
    "title": "凯风",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["凯风自南，", "吹彼棘心。", "棘心夭夭，", "母氏劬劳。"],
    "tags": ["母爱", "夏天"],
    "level": 2
  },
  {
    "title": "野有蔓草",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["野有蔓草，", "零露漙兮。", "有美一人，", "清扬婉兮。"],
    "tags": ["春天", "植物"],
    "level": 2
  },
  {
    "title": "黍离",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["彼黍离离，", "彼稷之苗。", "行迈靡靡，", "中心摇摇。"],
    "tags": ["田园", "思乡"],
    "level": 3
  },
  {
    "title": "君子于役",
    "author": "佚名",
    "dynasty": "先秦",
    "lines": ["君子于役，", "不知其期。", "曷至哉？", "鸡栖于埘。"],
    "tags": ["思乡", "动物"],
    "level": 2
  },
  {
    "title": "离骚",
    "author": "屈原",
    "dynasty": "先秦",
    "lines": ["路漫漫其修远兮，", "吾将上下而求索。"],
    "tags": ["励志", "山水"],
    "level": 3
  },
  {
    "title": "橘颂",
    "author": "屈原",
    "dynasty": "先秦",
    "lines": ["后皇嘉树，", "橘徕服兮。", "受命不迁，", "生南国兮。"],
    "tags": ["植物", "励志"],
    "level": 3
  },
  {
    "title": "江南",
    "author": "佚名",
    "dynasty": "汉",
    "lines": ["江南可采莲，", "莲叶何田田。", "鱼戏莲叶间。", "鱼戏莲叶东，", "鱼戏莲叶西，", "鱼戏莲叶南，", "鱼戏莲叶北。"],
    "tags": ["植物", "动物"],
    "level": 1
  },
  {
    "title": "长歌行",
    "author": "佚名",
    "dynasty": "汉",
    "lines": ["青青园中葵，", "朝露待日晞。", "阳春布德泽，", "万物生光辉。", "少壮不努力，", "老大徒伤悲。"],
    "tags": ["时间", "励志"],
    "level": 2
  },
  {
    "title": "大风歌",
    "author": "刘邦",
    "dynasty": "汉",
    "lines": ["大风起兮云飞扬，", "威加海内兮归故乡，", "安得猛士兮守四方！"],
    "tags": ["励志", "边塞"],
    "level": 2
  },
  {
    "title": "垓下歌",
    "author": "项羽",
    "dynasty": "汉",
    "lines": ["力拔山兮气盖世，", "时不利兮骓不逝。", "骓不逝兮可奈何，", "虞兮虞兮奈若何！"],
    "tags": ["励志", "边塞"],
    "level": 3
  },
  {
    "title": "上邪",
    "author": "佚名",
    "dynasty": "汉",
    "lines": ["上邪！", "我欲与君相知，", "长命无绝衰。"],
    "tags": ["友情", "冬天"],
    "level": 2
  },
  {
    "title": "陌上桑",
    "author": "佚名",
    "dynasty": "汉",
    "lines": ["日出东南隅，", "照我秦氏楼。", "秦氏有好女，", "自名为罗敷。"],
    "tags": ["田园", "夏天"],
    "level": 2
  },
  {
    "title": "十五从军征",
    "author": "佚名",
    "dynasty": "汉",
    "lines": ["十五从军征，", "八十始得归。", "道逢乡里人，", "家中有阿谁？"],
    "tags": ["思乡", "边塞"],
    "level": 3
  },
  {
    "title": "李延年歌",
    "author": "李延年",
    "dynasty": "汉",
    "lines": ["北方有佳人，", "绝世而独立。", "一顾倾人城，", "再顾倾人国。"],
    "tags": ["友情", "励志"],
    "level": 2
  },
  {
    "title": "秋风辞",
    "author": "刘彻",
    "dynasty": "汉",
    "lines": ["秋风起兮白云飞，", "草木黄落兮雁南归。", "兰有秀兮菊有芳，", "怀佳人兮不能忘。"],
    "tags": ["秋天", "动物"],
    "level": 3
  },
  {
    "title": "涉江采芙蓉",
    "author": "佚名",
    "dynasty": "汉",
    "lines": ["涉江采芙蓉，", "兰泽多芳草。", "采之欲遗谁？", "所思在远道。"],
    "tags": ["植物", "思乡"],
    "level": 2
  },
  {
    "title": "迢迢牵牛星",
    "author": "佚名",
    "dynasty": "汉",
    "lines": ["迢迢牵牛星，", "皎皎河汉女。", "盈盈一水间，", "脉脉不得语。"],
    "tags": ["月亮", "友情"],
    "level": 3
  },
  {
    "title": "行行重行行",
    "author": "佚名",
    "dynasty": "汉",
    "lines": ["行行重行行，", "与君生别离。", "相去万余里，", "各在天一涯。"],
    "tags": ["思乡", "友情"],
    "level": 3
  },
  {
    "title": "观沧海",
    "author": "曹操",
    "dynasty": "魏晋",
    "lines": ["东临碣石，", "以观沧海。", "水何澹澹，", "山岛竦峙。", "树木丛生，", "百草丰茂。", "秋风萧瑟，", "洪波涌起。"],
    "tags": ["山水", "秋天"],
    "level": 3
  },
  {
    "title": "龟虽寿",
    "author": "曹操",
    "dynasty": "魏晋",
    "lines": ["老骥伏枥，", "志在千里。", "烈士暮年，", "壮心不已。"],
    "tags": ["励志", "动物"],
    "level": 3
  },
  {
    "title": "短歌行",
    "author": "曹操",
    "dynasty": "魏晋",
    "lines": ["对酒当歌，", "人生几何！", "譬如朝露，", "去日苦多。"],
    "tags": ["时间", "友情"],
    "level": 3
  },
  {
    "title": "七步诗",
    "author": "曹植",
    "dynasty": "魏晋",
    "lines": ["煮豆燃豆萁，", "豆在釜中泣。", "本是同根生，", "相煎何太急？"],
    "tags": ["植物", "友情"],
    "level": 2
  },
  {
    "title": "饮酒",
    "author": "陶渊明",
    "dynasty": "魏晋",
    "lines": ["结庐在人境，", "而无车马喧。", "问君何能尔，", "心远地自偏。", "采菊东篱下，", "悠然见南山。", "山气日夕佳，", "飞鸟相与还。"],
    "tags": ["植物", "田园"],
    "level": 3
  },
  {
    "title": "归园田居",
    "author": "陶渊明",
    "dynasty": "魏晋",
    "lines": ["种豆南山下，", "草盛豆苗稀。", "晨兴理荒秽，", "带月荷锄归。"],
    "tags": ["田园", "月亮"],
    "level": 2
  },
  {
    "title": "杂诗",
    "author": "陶渊明",
    "dynasty": "魏晋",
    "lines": ["盛年不重来，", "一日难再晨。", "及时当勉励，", "岁月不待人。"],
    "tags": ["时间", "励志"],
    "level": 2
  },
  {
    "title": "赠范晔",
    "author": "陆凯",
    "dynasty": "魏晋",
    "lines": ["折花逢驿使，", "寄与陇头人。", "江南无所有，", "聊赠一枝春。"],
    "tags": ["友情", "植物"],
    "level": 2
  },
  {
    "title": "咏雪",
    "author": "谢道韫",
    "dynasty": "魏晋",
    "lines": ["白雪纷纷何所似？", "未若柳絮因风起。"],
    "tags": ["雪", "冬天"],
    "level": 2
  },
  {
    "title": "思吴江歌",
    "author": "张翰",
    "dynasty": "魏晋",
    "lines": ["秋风起兮木叶飞，", "吴江水兮鲈正肥。", "三千里兮家未归，", "恨难禁兮仰天悲。"],
    "tags": ["秋天", "思乡"],
    "level": 3
  },
  {
    "title": "燕歌行",
    "author": "曹丕",
    "dynasty": "魏晋",
    "lines": ["秋风萧瑟天气凉，", "草木摇落露为霜。", "群燕辞归鹄南翔，", "念君客游思断肠。"],
    "tags": ["秋天", "思乡"],
    "level": 3
  },
  {
    "title": "敕勒歌",
    "author": "佚名",
    "dynasty": "南北朝",
    "lines": ["敕勒川，", "阴山下。", "天似穹庐，", "笼盖四野。", "天苍苍，", "野茫茫，", "风吹草低见牛羊。"],
    "tags": ["田园", "动物"],
    "level": 1
  },
  {
    "title": "木兰诗",
    "author": "佚名",
    "dynasty": "南北朝",
    "lines": ["唧唧复唧唧，", "木兰当户织。", "不闻机杼声，", "惟闻女叹息。"],
    "tags": ["动物", "励志"],
    "level": 2
  },
  {
    "title": "西洲曲",
    "author": "佚名",
    "dynasty": "南北朝",
    "lines": ["采莲南塘秋，", "莲花过人头。", "低头弄莲子，", "莲子清如水。"],
    "tags": ["植物", "秋天"],
    "level": 3
  },
  {
    "title": "子夜歌",
    "author": "佚名",
    "dynasty": "南北朝",
    "lines": ["始欲识郎时，", "两心望如一。", "理丝入残机，", "何悟不成匹。"],
    "tags": ["友情", "植物"],
    "level": 2
  },
  {
    "title": "华山畿",
    "author": "佚名",
    "dynasty": "南北朝",
    "lines": ["君既为侬死，", "独活为谁施？", "欢若见怜时，", "棺木为侬开。"],
    "tags": ["友情", "励志"],
    "level": 3
  },
  {
    "title": "陇头歌辞",
    "author": "佚名",
    "dynasty": "南北朝",
    "lines": ["陇头流水，", "流离山下。", "念吾一身，", "飘然旷野。"],
    "tags": ["山水", "思乡"],
    "level": 3
  },
  {
    "title": "折杨柳歌辞",
    "author": "佚名",
    "dynasty": "南北朝",
    "lines": ["健儿须快马，", "快马须健儿。", "跸跋黄尘下，", "然后别雄雌。"],
    "tags": ["边塞", "动物"],
    "level": 3
  },
  {
    "title": "玉树后庭花",
    "author": "陈叔宝",
    "dynasty": "南北朝",
    "lines": ["丽宇芳林对高阁，", "新妆艳质本倾城。", "映户凝娇乍不进，", "出帷含态笑相迎。"],
    "tags": ["花", "友情"],
    "level": 3
  },
  {
    "title": "企喻歌",
    "author": "佚名",
    "dynasty": "南北朝",
    "lines": ["男儿欲作健，", "结伴不须多。", "鹞子经天飞，", "群雀两向波。"],
    "tags": ["边塞", "动物"],
    "level": 2
  },
  {
    "title": "人日思归",
    "author": "薛道衡",
    "dynasty": "隋",
    "lines": ["入春才七日，", "离家已二年。", "人归落雁后，", "思发在花前。"],
    "tags": ["思乡", "春天"],
    "level": 2
  },
  {
    "title": "送别",
    "author": "佚名",
    "dynasty": "隋",
    "lines": ["杨柳青青著地垂，", "杨花漫漫搅天飞。", "柳条折尽花飞尽，", "借问行人归不归。"],
    "tags": ["送别", "春天"],
    "level": 2
  },
  {
    "title": "天净沙·秋思",
    "author": "马致远",
    "dynasty": "元",
    "lines": ["枯藤老树昏鸦，", "小桥流水人家，", "古道西风瘦马。", "夕阳西下，", "断肠人在天涯。"],
    "tags": ["秋天", "思乡"],
    "level": 2
  },
  {
    "title": "天净沙·秋",
    "author": "白朴",
    "dynasty": "元",
    "lines": ["孤村落日残霞，", "轻烟老树寒鸦，", "一点飞鸿影下。", "青山绿水，", "白草红叶黄花。"],
    "tags": ["秋天", "山水"],
    "level": 2
  },
  {
    "title": "山坡羊·潼关怀古",
    "author": "张养浩",
    "dynasty": "元",
    "lines": ["峰峦如聚，", "波涛如怒，", "山河表里潼关路。", "望西都，", "意踌躇。"],
    "tags": ["山水", "边塞"],
    "level": 3
  },
  {
    "title": "沉醉东风·渔父",
    "author": "白朴",
    "dynasty": "元",
    "lines": ["黄芦岸白蘋渡口，", "绿杨堤红蓼滩头。", "虽无刎颈交，", "却有忘机友。"],
    "tags": ["山水", "友情"],
    "level": 3
  },
  {
    "title": "清江引·秋居",
    "author": "吴西逸",
    "dynasty": "元",
    "lines": ["白雁乱飞秋似雪，", "清露生凉夜。", "扫却石边云，", "醉踏松根月。"],
    "tags": ["秋天", "月亮"],
    "level": 3
  },
  {
    "title": "水仙子·夜雨",
    "author": "徐再思",
    "dynasty": "元",
    "lines": ["一声梧叶一声秋，", "一点芭蕉一点愁，", "三更归梦三更后。"],
    "tags": ["秋天", "思乡"],
    "level": 3
  },
  {
    "title": "寿阳曲·江天暮雪",
    "author": "马致远",
    "dynasty": "元",
    "lines": ["天将暮，", "雪乱舞，", "半梅花半飘柳絮。", "江上晚来堪画处，", "钓鱼人一蓑归去。"],
    "tags": ["雪", "冬天"],
    "level": 3
  },
  {
    "title": "凭栏人·寄征衣",
    "author": "姚燧",
    "dynasty": "元",
    "lines": ["欲寄君衣君不还，", "不寄君衣君又寒。", "寄与不寄间，", "妾身千万难。"],
    "tags": ["思乡", "冬天"],
    "level": 3
  },
  {
    "title": "石灰吟",
    "author": "于谦",
    "dynasty": "明",
    "lines": ["千锤万凿出深山，", "烈火焚烧若等闲。", "粉骨碎身浑不怕，", "要留清白在人间。"],
    "tags": ["励志", "冬天"],
    "level": 2
  },
  {
    "title": "墨梅",
    "author": "王冕",
    "dynasty": "明",
    "lines": ["我家洗砚池头树，", "朵朵花开淡墨痕。", "不要人夸好颜色，", "只留清气满乾坤。"],
    "tags": ["花", "励志"],
    "level": 2
  },
  {
    "title": "画鸡",
    "author": "唐寅",
    "dynasty": "明",
    "lines": ["头上红冠不用裁，", "满身雪白走将来。", "平生不敢轻言语，", "一叫千门万户开。"],
    "tags": ["动物", "励志"],
    "level": 2
  },
  {
    "title": "明日歌",
    "author": "钱福",
    "dynasty": "明",
    "lines": ["明日复明日，", "明日何其多。", "我生待明日，", "万事成蹉跎。"],
    "tags": ["时间", "励志"],
    "level": 2
  },
  {
    "title": "言志",
    "author": "唐寅",
    "dynasty": "明",
    "lines": ["不炼金丹不坐禅，", "不为商贾不耕田。", "闲来写就青山卖，", "不使人间造孽钱。"],
    "tags": ["山水", "励志"],
    "level": 3
  },
  {
    "title": "马上作",
    "author": "戚继光",
    "dynasty": "明",
    "lines": ["南北驱驰报主情，", "江花边草笑平生。", "一年三百六十日，", "多是横戈马上行。"],
    "tags": ["边塞", "励志"],
    "level": 3
  },
  {
    "title": "就义诗",
    "author": "杨继盛",
    "dynasty": "明",
    "lines": ["浩气还太虚，", "丹心照千古。", "生平未报国，", "留作忠魂补。"],
    "tags": ["励志", "边塞"],
    "level": 3
  },
  {
    "title": "临江仙·滚滚长江东逝水",
    "author": "杨慎",
    "dynasty": "明",
    "lines": ["滚滚长江东逝水，", "浪花淘尽英雄。", "是非成败转头空。"],
    "tags": ["时间", "山水"],
    "level": 3
  },
  {
    "title": "春雁",
    "author": "王恭",
    "dynasty": "明",
    "lines": ["春风一夜到衡阳，", "楚水燕山万里长。", "莫道春来便归去，", "江南虽好是他乡。"],
    "tags": ["动物", "思乡"],
    "level": 3
  },
  {
    "title": "竹石",
    "author": "郑燮",
    "dynasty": "清",
    "lines": ["咬定青山不放松，", "立根原在破岩中。", "千磨万击还坚劲，", "任尔东西南北风。"],
    "tags": ["植物", "励志"],
    "level": 2
  },
  {
    "title": "苔",
    "author": "袁枚",
    "dynasty": "清",
    "lines": ["白日不到处，", "青春恰自来。", "苔花如米小，", "也学牡丹开。"],
    "tags": ["植物", "励志"],
    "level": 2
  },
  {
    "title": "舟夜书所见",
    "author": "查慎行",
    "dynasty": "清",
    "lines": ["月黑见渔灯，", "孤光一点萤。", "微微风簇浪，", "散作满河星。"],
    "tags": ["月亮", "山水"],
    "level": 2
  },
  {
    "title": "十二月十五夜",
    "author": "袁枚",
    "dynasty": "清",
    "lines": ["沉沉更鼓急，", "渐渐人声绝。", "吹灯窗更明，", "月照一天雪。"],
    "tags": ["冬天", "月亮"],
    "level": 2
  },
  {
    "title": "咏雪",
    "author": "郑燮",
    "dynasty": "清",
    "lines": ["一片两片三四片，", "五六七八九十片。", "千片万片无数片，", "飞入梅花都不见。"],
    "tags": ["雪", "冬天"],
    "level": 2
  },
  {
    "title": "己亥杂诗·其五",
    "author": "龚自珍",
    "dynasty": "清",
    "lines": ["浩荡离愁白日斜，", "吟鞭东指即天涯。", "落红不是无情物，", "化作春泥更护花。"],
    "tags": ["花", "励志"],
    "level": 2
  },
  {
    "title": "己亥杂诗·其二百二十",
    "author": "龚自珍",
    "dynasty": "清",
    "lines": ["九州生气恃风雷，", "万马齐喑究可哀。", "我劝天公重抖擞，", "不拘一格降人才。"],
    "tags": ["励志", "边塞"],
    "level": 2
  },
  {
    "title": "论诗",
    "author": "赵翼",
    "dynasty": "清",
    "lines": ["李杜诗篇万口传，", "至今已觉不新鲜。", "江山代有才人出，", "各领风骚数百年。"],
    "tags": ["读书", "励志"],
    "level": 2
  },
  {
    "title": "长相思·山一程",
    "author": "纳兰性德",
    "dynasty": "清",
    "lines": ["山一程，", "水一程，", "身向榆关那畔行，", "夜深千帐灯。"],
    "tags": ["思乡", "山水"],
    "level": 2
  },
  {
    "title": "对酒",
    "author": "秋瑾",
    "dynasty": "清",
    "lines": ["不惜千金买宝刀，", "貂裘换酒也堪豪。", "一腔热血勤珍重，", "洒去犹能化碧涛。"],
    "tags": ["励志", "边塞"],
    "level": 3
  },
  {
    "title": "春愁",
    "author": "丘逢甲",
    "dynasty": "清",
    "lines": ["春愁难遣强看山，", "往事惊心泪欲潸。", "四百万人同一哭，", "去年今日割台湾。"],
    "tags": ["思乡", "春天"],
    "level": 3
  },
  {
    "title": "出塞",
    "author": "徐锡麟",
    "dynasty": "清",
    "lines": ["军歌应唱大刀环，", "誓灭胡奴出玉关。", "只解沙场为国死，", "何须马革裹尸还。"],
    "tags": ["边塞", "励志"],
    "level": 3
  },
  {
    "title": "狱中题壁",
    "author": "谭嗣同",
    "dynasty": "清",
    "lines": ["望门投止思张俭，", "忍死须臾待杜根。", "我自横刀向天笑，", "去留肝胆两昆仑。"],
    "tags": ["励志", "边塞"],
    "level": 3
  },
  {
    "title": "题秋江独钓图",
    "author": "王士祯",
    "dynasty": "清",
    "lines": ["一蓑一笠一扁舟，", "一丈丝纶一寸钩。", "一曲高歌一樽酒，", "一人独钓一江秋。"],
    "tags": ["秋天", "山水"],
    "level": 2
  },
  {
    "title": "癸巳除夕偶成",
    "author": "黄景仁",
    "dynasty": "清",
    "lines": ["千家笑语漏迟迟，", "忧患潜从物外知。", "悄立市桥人不识，", "一星如月看多时。"],
    "tags": ["冬天", "思乡"],
    "level": 3
  },
  {
    "title": "赠梁任父同年",
    "author": "黄遵宪",
    "dynasty": "清",
    "lines": ["寸寸山河寸寸金，", "侉离分裂力谁任。", "杜鹃再拜忧天泪，", "精卫无穷填海心。"],
    "tags": ["边塞", "励志"],
    "level": 3
  },
  {
    "title": "漫感",
    "author": "龚自珍",
    "dynasty": "清",
    "lines": ["绝域从军计惘然，", "东南幽恨满词笺。", "一箫一剑平生意，", "负尽狂名十五年。"],
    "tags": ["边塞", "励志"],
    "level": 3
  },
  {
    "title": "岁暮到家",
    "author": "蒋士铨",
    "dynasty": "清",
    "lines": ["爱子心无尽，", "归家喜及辰。", "寒衣针线密，", "家信墨痕新。"],
    "tags": ["母爱", "冬天"],
    "level": 2
  },
  {
    "title": "新雷",
    "author": "张维屏",
    "dynasty": "清",
    "lines": ["造物无言却有情，", "每于寒尽觉春生。", "千红万紫安排著，", "只待新雷第一声。"],
    "tags": ["春天", "励志"],
    "level": 2
  }
]
