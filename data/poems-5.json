[
  {
    "title": "绝句漫兴",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": ["糁径杨花铺白毡，", "点溪荷叶叠青钱。", "笋根雉子无人见，", "沙上凫雏傍母眠。"],
    "tags": ["夏天", "动物", "田园"],
    "level": 3
  },
  {
    "title": "山中送别",
    "author": "王维",
    "dynasty": "唐",
    "lines": ["山中相送罢，", "日暮掩柴扉。", "春草明年绿，", "王孙归不归。"],
    "tags": ["送别", "春天", "友情"],
    "level": 1
  },
  {
    "title": "画",
    "author": "王维",
    "dynasty": "唐",
    "lines": ["远看山有色，", "近听水无声。", "春去花还在，", "人来鸟不惊。"],
    "tags": ["山水", "童趣", "花"],
    "level": 1
  },
  {
    "title": "商山早行",
    "author": "温庭筠",
    "dynasty": "唐",
    "lines": ["晨起动征铎，", "客行悲故乡。", "鸡声茅店月，", "人迹板桥霜。", "槲叶落山路，", "枳花明驿墙。", "因思杜陵梦，", "凫雁满回塘。"],
    "tags": ["思乡", "秋天", "月亮"],
    "level": 3
  },
  {
    "title": "宫词",
    "author": "张祜",
    "dynasty": "唐",
    "lines": ["故国三千里，", "深宫二十年。", "一声何满子，", "双泪落君前。"],
    "tags": ["思乡", "时间"],
    "level": 2
  },
  {
    "title": "题金陵渡",
    "author": "张祜",
    "dynasty": "唐",
    "lines": ["金陵津渡小山楼，", "一宿行人自可愁。", "潮落夜江斜月里，", "两三星火是瓜洲。"],
    "tags": ["月亮", "思乡", "山水"],
    "level": 2
  },
  {
    "title": "题都城南庄",
    "author": "崔护",
    "dynasty": "唐",
    "lines": ["去年今日此门中，", "人面桃花相映红。", "人面不知何处去，", "桃花依旧笑春风。"],
    "tags": ["春天", "花", "时间"],
    "level": 2
  },
  {
    "title": "十五夜望月",
    "author": "王建",
    "dynasty": "唐",
    "lines": ["中庭地白树栖鸦，", "冷露无声湿桂花。", "今夜月明人尽望，", "不知秋思落谁家。"],
    "tags": ["月亮", "秋天", "节日"],
    "level": 2
  },
  {
    "title": "雨过山村",
    "author": "王建",
    "dynasty": "唐",
    "lines": ["雨里鸡鸣一两家，", "竹溪村路板桥斜。", "妇姑相唤浴蚕去，", "闲看中庭栀子花。"],
    "tags": ["田园", "雨", "花"],
    "level": 2
  },
  {
    "title": "晚春",
    "author": "韩愈",
    "dynasty": "唐",
    "lines": ["草树知春不久归，", "百般红紫斗芳菲。", "杨花榆荚无才思，", "惟解漫天作雪飞。"],
    "tags": ["春天", "花", "植物"],
    "level": 2
  },
  {
    "title": "早春呈水部张十八员外",
    "author": "韩愈",
    "dynasty": "唐",
    "lines": ["天街小雨润如酥，", "草色遥看近却无。", "最是一年春好处，", "绝胜烟柳满皇都。"],
    "tags": ["春天", "雨", "植物"],
    "level": 2
  },
  {
    "title": "菊花",
    "author": "元稹",
    "dynasty": "唐",
    "lines": ["秋丛绕舍似陶家，", "遍绕篱边日渐斜。", "不是花中偏爱菊，", "此花开尽更无花。"],
    "tags": ["秋天", "花", "植物"],
    "level": 2
  },
  {
    "title": "马诗",
    "author": "李贺",
    "dynasty": "唐",
    "lines": ["大漠沙如雪，", "燕山月似钩。", "何当金络脑，", "快走踏清秋。"],
    "tags": ["动物", "励志", "边塞"],
    "level": 2
  },
  {
    "title": "长干行",
    "author": "崔颢",
    "dynasty": "唐",
    "lines": ["君家何处住，", "妾住在横塘。", "停船暂借问，", "或恐是同乡。"],
    "tags": ["思乡", "友情"],
    "level": 1
  },
  {
    "title": "渔歌子",
    "author": "张志和",
    "dynasty": "唐",
    "lines": ["西塞山前白鹭飞，", "桃花流水鳜鱼肥。", "青箬笠，", "绿蓑衣，", "斜风细雨不须归。"],
    "tags": ["山水", "田园", "雨"],
    "level": 2
  },
  {
    "title": "相见欢·无言独上西楼",
    "author": "李煜",
    "dynasty": "唐",
    "lines": ["无言独上西楼，", "月如钩。", "寂寞梧桐深院锁清秋。", "剪不断，", "理还乱，", "是离愁。", "别是一般滋味在心头。"],
    "tags": ["月亮", "秋天", "思乡"],
    "level": 3
  },
  {
    "title": "浣溪沙·一曲新词酒一杯",
    "author": "晏殊",
    "dynasty": "宋",
    "lines": ["一曲新词酒一杯，", "去年天气旧亭台。", "夕阳西下几时回？", "无可奈何花落去，", "似曾相识燕归来。", "小园香径独徘徊。"],
    "tags": ["时间", "春天", "花"],
    "level": 3
  },
  {
    "title": "浣溪沙·山下兰芽短浸溪",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["山下兰芽短浸溪，", "松间沙路净无泥。", "萧萧暮雨子规啼。", "谁道人生无再少？", "门前流水尚能西！", "休将白发唱黄鸡。"],
    "tags": ["励志", "山水", "雨"],
    "level": 3
  },
  {
    "title": "秋思",
    "author": "张籍",
    "dynasty": "唐",
    "lines": ["洛阳城里见秋风，", "欲作家书意万重。", "复恐匆匆说不尽，", "行人临发又开封。"],
    "tags": ["思乡", "秋天"],
    "level": 2
  },
  {
    "title": "春怨",
    "author": "金昌绪",
    "dynasty": "唐",
    "lines": ["打起黄莺儿，", "莫教枝上啼。", "啼时惊妾梦，", "不得到辽西。"],
    "tags": ["春天", "动物", "思乡"],
    "level": 2
  },
  {
    "title": "登幽州台歌",
    "author": "陈子昂",
    "dynasty": "唐",
    "lines": ["前不见古人，", "后不见来者。", "念天地之悠悠，", "独怆然而涕下。"],
    "tags": ["时间", "励志"],
    "level": 2
  },
  {
    "title": "于易水送人",
    "author": "骆宾王",
    "dynasty": "唐",
    "lines": ["此地别燕丹，", "壮士发冲冠。", "昔时人已没，", "今日水犹寒。"],
    "tags": ["送别", "友情", "励志"],
    "level": 2
  },
  {
    "title": "送杜少府之任蜀州",
    "author": "王勃",
    "dynasty": "唐",
    "lines": ["城阙辅三秦，", "风烟望五津。", "与君离别意，", "同是宦游人。", "海内存知己，", "天涯若比邻。", "无为在歧路，", "儿女共沾巾。"],
    "tags": ["送别", "友情", "励志"],
    "level": 3
  },
  {
    "title": "望岳",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": ["岱宗夫如何？", "齐鲁青未了。", "造化钟神秀，", "阴阳割昏晓。", "荡胸生曾云，", "决眦入归鸟。", "会当凌绝顶，", "一览众山小。"],
    "tags": ["山水", "励志"],
    "level": 3
  },
  {
    "title": "月夜忆舍弟",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": ["戍鼓断人行，", "边秋一雁声。", "露从今夜白，", "月是故乡明。", "有弟皆分散，", "无家问死生。", "寄书长不达，", "况乃未休兵。"],
    "tags": ["思乡", "月亮", "秋天"],
    "level": 3
  },
  {
    "title": "山亭夏日",
    "author": "高骈",
    "dynasty": "唐",
    "lines": ["绿树阴浓夏日长，", "楼台倒影入池塘。", "水晶帘动微风起，", "满架蔷薇一院香。"],
    "tags": ["夏天", "花", "田园"],
    "level": 2
  },
  {
    "title": "城东早春",
    "author": "杨巨源",
    "dynasty": "唐",
    "lines": ["诗家清景在新春，", "绿柳才黄半未匀。", "若待上林花似锦，", "出门俱是看花人。"],
    "tags": ["春天", "植物", "花"],
    "level": 2
  },
  {
    "title": "江村即事",
    "author": "司空曙",
    "dynasty": "唐",
    "lines": ["钓罢归来不系船，", "江村月落正堪眠。", "纵然一夜风吹去，", "只在芦花浅水边。"],
    "tags": ["田园", "月亮", "山水"],
    "level": 2
  },
  {
    "title": "村夜",
    "author": "白居易",
    "dynasty": "唐",
    "lines": ["霜草苍苍虫切切，", "村南村北行人绝。", "独出前门望野田，", "月明荞麦花如雪。"],
    "tags": ["月亮", "田园", "秋天"],
    "level": 2
  },
  {
    "title": "鸟",
    "author": "白居易",
    "dynasty": "唐",
    "lines": ["谁道群生性命微，", "一般骨肉一般皮。", "劝君莫打枝头鸟，", "子在巢中望母归。"],
    "tags": ["动物", "母爱"],
    "level": 1
  },
  {
    "title": "夜雪",
    "author": "白居易",
    "dynasty": "唐",
    "lines": ["已讶衾枕冷，", "复见窗户明。", "夜深知雪重，", "时闻折竹声。"],
    "tags": ["冬天", "雪"],
    "level": 1
  },
  {
    "title": "白云泉",
    "author": "白居易",
    "dynasty": "唐",
    "lines": ["天平山上白云泉，", "云自无心水自闲。", "何必奔冲山下去，", "更添波浪向人间。"],
    "tags": ["山水", "田园"],
    "level": 2
  },
  {
    "title": "生查子·元夕",
    "author": "欧阳修",
    "dynasty": "宋",
    "lines": ["去年元夜时，", "花市灯如昼。", "月上柳梢头，", "人约黄昏后。", "今年元夜时，", "月与灯依旧。", "不见去年人，", "泪湿春衫袖。"],
    "tags": ["节日", "月亮", "时间"],
    "level": 2
  },
  {
    "title": "卜算子·我住长江头",
    "author": "李之仪",
    "dynasty": "宋",
    "lines": ["我住长江头，", "君住长江尾。", "日日思君不见君，", "共饮长江水。", "此水几时休，", "此恨何时已。", "只愿君心似我心，", "定不负相思意。"],
    "tags": ["思乡", "山水", "友情"],
    "level": 2
  },
  {
    "title": "卜算子·咏梅",
    "author": "陆游",
    "dynasty": "宋",
    "lines": ["驿外断桥边，", "寂寞开无主。", "已是黄昏独自愁，", "更著风和雨。", "无意苦争春，", "一任群芳妒。", "零落成泥碾作尘，", "只有香如故。"],
    "tags": ["冬天", "花", "励志"],
    "level": 3
  }
]
