[
  {
    "title": "山村咏怀",
    "author": "邵雍",
    "dynasty": "宋",
    "lines": ["一去二三里，", "烟村四五家。", "亭台六七座，", "八九十枝花。"],
    "tags": ["童趣", "田园", "花"],
    "level": 1
  },
  {
    "title": "桂源铺",
    "author": "杨万里",
    "dynasty": "宋",
    "lines": ["万山不许一溪奔，", "拦得溪声日夜喧。", "到得前头山脚尽，", "堂堂溪水出前村。"],
    "tags": ["山水", "励志"],
    "level": 2
  },
  {
    "title": "北陂杏花",
    "author": "王安石",
    "dynasty": "宋",
    "lines": ["一陂春水绕花身，", "花影妖娆各占春。", "纵被春风吹作雪，", "绝胜南陌碾成尘。"],
    "tags": ["春天", "花"],
    "level": 3
  },
  {
    "title": "春夜",
    "author": "王安石",
    "dynasty": "宋",
    "lines": ["金炉香烬漏声残，", "翦翦轻风阵阵寒。", "春色恼人眠不得，", "月移花影上栏干。"],
    "tags": ["春天", "月亮", "花"],
    "level": 3
  },
  {
    "title": "鄂州南楼书事",
    "author": "黄庭坚",
    "dynasty": "宋",
    "lines": ["四顾山光接水光，", "凭栏十里芰荷香。", "清风明月无人管，", "并作南楼一味凉。"],
    "tags": ["夏天", "山水", "月亮"],
    "level": 2
  },
  {
    "title": "初夏游张园",
    "author": "戴复古",
    "dynasty": "宋",
    "lines": ["乳鸭池塘水浅深，", "熟梅天气半晴阴。", "东园载酒西园醉，", "摘尽枇杷一树金。"],
    "tags": ["夏天", "田园", "植物"],
    "level": 2
  },
  {
    "title": "即景",
    "author": "朱淑真",
    "dynasty": "宋",
    "lines": ["竹摇清影罩幽窗，", "两两时禽噪夕阳。", "谢却海棠飞尽絮，", "困人天气日初长。"],
    "tags": ["夏天", "植物"],
    "level": 3
  },
  {
    "title": "咏华山",
    "author": "寇准",
    "dynasty": "宋",
    "lines": ["只有天在上，", "更无山与齐。", "举头红日近，", "回首白云低。"],
    "tags": ["山水", "童趣"],
    "level": 1
  },
  {
    "title": "喜晴",
    "author": "范成大",
    "dynasty": "宋",
    "lines": ["窗间梅熟落蒂，", "墙下笋成出林。", "连雨不知春去，", "一晴方觉夏深。"],
    "tags": ["夏天", "田园", "雨"],
    "level": 2
  },
  {
    "title": "初秋行圃",
    "author": "杨万里",
    "dynasty": "宋",
    "lines": ["落日无情最有情，", "遍催万树暮蝉鸣。", "听来咫尺无寻处，", "寻到旁边却不声。"],
    "tags": ["秋天", "童趣", "动物"],
    "level": 2
  },
  {
    "title": "梅花绝句",
    "author": "陆游",
    "dynasty": "宋",
    "lines": ["闻道梅花坼晓风，", "雪堆遍满四山中。", "何方可化身千亿，", "一树梅花一放翁。"],
    "tags": ["冬天", "花", "雪"],
    "level": 3
  },
  {
    "title": "乡思",
    "author": "李觏",
    "dynasty": "宋",
    "lines": ["人言落日是天涯，", "望极天涯不见家。", "已恨碧山相阻隔，", "碧山还被暮云遮。"],
    "tags": ["思乡", "山水"],
    "level": 2
  },
  {
    "title": "三月晦日偶题",
    "author": "秦观",
    "dynasty": "宋",
    "lines": ["节物相催各自新，", "痴心儿女挽留春。", "芳菲歇去何须恨，", "夏木阴阴正可人。"],
    "tags": ["春天", "夏天", "时间"],
    "level": 3
  },
  {
    "title": "乙卯重五诗",
    "author": "陆游",
    "dynasty": "宋",
    "lines": ["重五山村好，", "榴花忽已繁。", "粽包分两髻，", "艾束著危冠。", "旧俗方储药，", "羸躯亦点丹。", "日斜吾事毕，", "一笑向杯盘。"],
    "tags": ["节日", "田园"],
    "level": 3
  },
  {
    "title": "神童诗·劝学",
    "author": "汪洙",
    "dynasty": "宋",
    "lines": ["天子重英豪，", "文章教尔曹。", "万般皆下品，", "惟有读书高。"],
    "tags": ["读书", "励志"],
    "level": 1
  },
  {
    "title": "神童诗·四季",
    "author": "汪洙",
    "dynasty": "宋",
    "lines": ["春游芳草地，", "夏赏绿荷池。", "秋饮黄花酒，", "冬吟白雪诗。"],
    "tags": ["时间", "春天", "冬天"],
    "level": 1
  },
  {
    "title": "断句",
    "author": "苏麟",
    "dynasty": "宋",
    "lines": ["近水楼台先得月，", "向阳花木易为春。"],
    "tags": ["月亮", "春天", "植物"],
    "level": 2
  },
  {
    "title": "立春",
    "author": "白玉蟾",
    "dynasty": "宋",
    "lines": ["东风吹散梅梢雪，", "一夜挽回天下春。", "从此阳春应有脚，", "百花富贵草精神。"],
    "tags": ["春天", "节日", "雪"],
    "level": 3
  },
  {
    "title": "中秋登楼望月",
    "author": "米芾",
    "dynasty": "宋",
    "lines": ["目穷淮海满如银，", "万道虹光育蚌珍。", "天上若无修月户，", "桂枝撑损向西轮。"],
    "tags": ["月亮", "节日"],
    "level": 3
  },
  {
    "title": "寻胡隐君",
    "author": "高启",
    "dynasty": "明",
    "lines": ["渡水复渡水，", "看花还看花。", "春风江上路，", "不觉到君家。"],
    "tags": ["春天", "友情", "花"],
    "level": 1
  },
  {
    "title": "牧牛词",
    "author": "高启",
    "dynasty": "明",
    "lines": ["尔牛角弯环，", "我牛尾秃速。", "共拈短笛与长鞭，", "南陇东冈去相逐。"],
    "tags": ["童趣", "田园", "动物"],
    "level": 2
  },
  {
    "title": "天平山中",
    "author": "杨基",
    "dynasty": "明",
    "lines": ["细雨茸茸湿楝花，", "南风树树熟枇杷。", "徐行不记山深浅，", "一路莺啼送到家。"],
    "tags": ["山水", "夏天", "雨"],
    "level": 2
  },
  {
    "title": "京师得家书",
    "author": "袁凯",
    "dynasty": "明",
    "lines": ["江水三千里，", "家书十五行。", "行行无别语，", "只道早还乡。"],
    "tags": ["思乡", "山水"],
    "level": 1
  },
  {
    "title": "蔽月山房",
    "author": "王守仁",
    "dynasty": "明",
    "lines": ["山近月远觉月小，", "便道此山大于月。", "若人有眼大如天，", "当见山小月更阔。"],
    "tags": ["月亮", "童趣", "山水"],
    "level": 2
  },
  {
    "title": "咏兰花",
    "author": "张羽",
    "dynasty": "明",
    "lines": ["能白更兼黄，", "无人亦自芳。", "寸心原不大，", "容得许多香。"],
    "tags": ["植物", "励志", "花"],
    "level": 1
  },
  {
    "title": "除夜太原寒甚",
    "author": "于谦",
    "dynasty": "明",
    "lines": ["寄语天涯客，", "轻寒底用愁。", "春风来不远，", "只在屋东头。"],
    "tags": ["节日", "春天", "冬天"],
    "level": 2
  },
  {
    "title": "九日",
    "author": "文森",
    "dynasty": "明",
    "lines": ["三载重阳菊，", "开时不在家。", "何期今日酒，", "忽对故园花。"],
    "tags": ["节日", "思乡", "花"],
    "level": 2
  },
  {
    "title": "山中雪后",
    "author": "郑燮",
    "dynasty": "清",
    "lines": ["晨起开门雪满山，", "雪晴云淡日光寒。", "檐流未滴梅花冻，", "一种清孤不等闲。"],
    "tags": ["雪", "冬天", "花"],
    "level": 3
  },
  {
    "title": "推窗",
    "author": "袁枚",
    "dynasty": "清",
    "lines": ["连宵风雨恶，", "蓬户不轻开。", "山似相思久，", "推窗扑面来。"],
    "tags": ["山水", "雨"],
    "level": 2
  },
  {
    "title": "己亥杂诗·其一二五",
    "author": "龚自珍",
    "dynasty": "清",
    "lines": ["九州生气恃风雷，", "万马齐喑究可哀。", "我劝天公重抖擞，", "不拘一格降人才。"],
    "tags": ["励志", "读书"],
    "level": 3
  },
  {
    "title": "真州绝句",
    "author": "王士祯",
    "dynasty": "清",
    "lines": ["江干多是钓人居，", "柳陌菱塘一带疏。", "好是日斜风定后，", "半江红树卖鲈鱼。"],
    "tags": ["山水", "秋天", "田园"],
    "level": 3
  },
  {
    "title": "野步",
    "author": "赵翼",
    "dynasty": "清",
    "lines": ["峭寒催换木棉裘，", "倚杖郊原作近游。", "最是秋风管闲事，", "红他枫叶白人头。"],
    "tags": ["秋天", "时间"],
    "level": 3
  },
  {
    "title": "潍县署中画竹",
    "author": "郑燮",
    "dynasty": "清",
    "lines": ["衙斋卧听萧萧竹，", "疑是民间疾苦声。", "些小吾曹州县吏，", "一枝一叶总关情。"],
    "tags": ["植物", "励志"],
    "level": 3
  },
  {
    "title": "湖上杂诗",
    "author": "袁枚",
    "dynasty": "清",
    "lines": ["葛岭花开二月天，", "游人来往说神仙。", "老夫心与游人异，", "不羡神仙羡少年。"],
    "tags": ["春天", "时间", "花"],
    "level": 3
  },
  {
    "title": "甲午元旦",
    "author": "孔尚任",
    "dynasty": "清",
    "lines": ["萧疏白发不盈颠，", "守岁围炉竟废眠。", "剪烛催干消夜酒，", "倾囊分遍买春钱。"],
    "tags": ["节日", "冬天", "时间"],
    "level": 3
  }
]
