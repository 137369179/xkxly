[
  {
    "title": "题西林壁",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["横看成岭侧成峰，", "远近高低各不同。", "不识庐山真面目，", "只缘身在此山中。"],
    "tags": ["山水", "励志"],
    "level": 2
  },
  {
    "title": "饮湖上初晴后雨",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["水光潋滟晴方好，", "山色空蒙雨亦奇。", "欲把西湖比西子，", "淡妆浓抹总相宜。"],
    "tags": ["山水", "雨"],
    "level": 2
  },
  {
    "title": "惠崇春江晚景",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["竹外桃花三两枝，", "春江水暖鸭先知。", "蒌蒿满地芦芽短，", "正是河豚欲上时。"],
    "tags": ["春天", "动物", "山水"],
    "level": 2
  },
  {
    "title": "六月二十七日望湖楼醉书",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["黑云翻墨未遮山，", "白雨跳珠乱入船。", "卷地风来忽吹散，", "望湖楼下水如天。"],
    "tags": ["雨", "山水"],
    "level": 2
  },
  {
    "title": "赠刘景文",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["荷尽已无擎雨盖，", "菊残犹有傲霜枝。", "一年好景君须记，", "最是橙黄橘绿时。"],
    "tags": ["秋天", "植物", "励志"],
    "level": 2
  },
  {
    "title": "春宵",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["春宵一刻值千金，", "花有清香月有阴。", "歌管楼台声细细，", "秋千院落夜沉沉。"],
    "tags": ["春天", "月亮", "时间"],
    "level": 2
  },
  {
    "title": "海棠",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["东风袅袅泛崇光，", "香雾空蒙月转廊。", "只恐夜深花睡去，", "故烧高烛照红妆。"],
    "tags": ["花", "春天"],
    "level": 2
  },
  {
    "title": "花影",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["重重叠叠上瑶台，", "几度呼童扫不开。", "刚被太阳收拾去，", "却教明月送将来。"],
    "tags": ["花", "月亮"],
    "level": 2
  },
  {
    "title": "中秋月",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["暮云收尽溢清寒，", "银汉无声转玉盘。", "此生此夜不长好，", "明月明年何处看。"],
    "tags": ["月亮", "秋天", "思乡"],
    "level": 2
  },
  {
    "title": "东坡",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["雨洗东坡月色清，", "市人行尽野人行。", "莫嫌荦确坡头路，", "自爱铿然曳杖声。"],
    "tags": ["山水", "励志"],
    "level": 2
  },
  {
    "title": "琴诗",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["若言琴上有琴声，", "放在匣中何不鸣？", "若言声在指头上，", "何不于君指上听？"],
    "tags": ["励志", "读书"],
    "level": 2
  },
  {
    "title": "惠州一绝",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["罗浮山下四时春，", "卢橘杨梅次第新。", "日啖荔枝三百颗，", "不辞长作岭南人。"],
    "tags": ["植物", "励志"],
    "level": 2
  },
  {
    "title": "洗儿",
    "author": "苏轼",
    "dynasty": "宋",
    "lines": ["人皆养子望聪明，", "我被聪明误一生。", "惟愿孩儿愚且鲁，", "无灾无难到公卿。"],
    "tags": ["童趣", "母爱"],
    "level": 2
  },
  {
    "title": "元日",
    "author": "王安石",
    "dynasty": "宋",
    "lines": ["爆竹声中一岁除，", "春风送暖入屠苏。", "千门万户曈曈日，", "总把新桃换旧符。"],
    "tags": ["节日", "冬天", "励志"],
    "level": 2
  },
  {
    "title": "泊船瓜洲",
    "author": "王安石",
    "dynasty": "宋",
    "lines": ["京口瓜洲一水间，", "钟山只隔数重山。", "春风又绿江南岸，", "明月何时照我还。"],
    "tags": ["思乡", "春天", "月亮"],
    "level": 2
  },
  {
    "title": "梅花",
    "author": "王安石",
    "dynasty": "宋",
    "lines": ["墙角数枝梅，", "凌寒独自开。", "遥知不是雪，", "为有暗香来。"],
    "tags": ["冬天", "植物", "花"],
    "level": 2
  },
  {
    "title": "书湖阴先生壁",
    "author": "王安石",
    "dynasty": "宋",
    "lines": ["茅檐长扫净无苔，", "花木成畦手自栽。", "一水护田将绿绕，", "两山排闼送青来。"],
    "tags": ["田园", "山水", "植物"],
    "level": 2
  },
  {
    "title": "江上",
    "author": "王安石",
    "dynasty": "宋",
    "lines": ["江北秋阴一半开，", "晚云含雨却低回。", "青山缭绕疑无路，", "忽见千帆隐映来。"],
    "tags": ["山水", "秋天"],
    "level": 2
  },
  {
    "title": "钟山即事",
    "author": "王安石",
    "dynasty": "宋",
    "lines": ["涧水无声绕竹流，", "竹西花草弄春柔。", "茅檐相对坐终日，", "一鸟不鸣山更幽。"],
    "tags": ["山水", "春天", "动物"],
    "level": 2
  },
  {
    "title": "北山",
    "author": "王安石",
    "dynasty": "宋",
    "lines": ["北山输绿涨横陂，", "直堑回塘滟滟时。", "细数落花因坐久，", "缓寻芳草得迟归。"],
    "tags": ["山水", "春天", "花"],
    "level": 2
  },
  {
    "title": "登飞来峰",
    "author": "王安石",
    "dynasty": "宋",
    "lines": ["飞来山上千寻塔，", "闻说鸡鸣见日升。", "不畏浮云遮望眼，", "自缘身在最高层。"],
    "tags": ["山水", "励志"],
    "level": 2
  },
  {
    "title": "示儿",
    "author": "陆游",
    "dynasty": "宋",
    "lines": ["死去元知万事空，", "但悲不见九州同。", "王师北定中原日，", "家祭无忘告乃翁。"],
    "tags": ["励志", "思乡"],
    "level": 3
  },
  {
    "title": "秋夜将晓出篱门迎凉有感",
    "author": "陆游",
    "dynasty": "宋",
    "lines": ["三万里河东入海，", "五千仞岳上摩天。", "遗民泪尽胡尘里，", "南望王师又一年。"],
    "tags": ["秋天", "励志", "思乡"],
    "level": 3
  },
  {
    "title": "冬夜读书示子聿",
    "author": "陆游",
    "dynasty": "宋",
    "lines": ["古人学问无遗力，", "少壮工夫老始成。", "纸上得来终觉浅，", "绝知此事要躬行。"],
    "tags": ["读书", "励志", "冬天"],
    "level": 3
  },
  {
    "title": "游山西村",
    "author": "陆游",
    "dynasty": "宋",
    "lines": ["莫笑农家腊酒浑，", "丰年留客足鸡豚。", "山重水复疑无路，", "柳暗花明又一村。", "箫鼓追随春社近，", "衣冠简朴古风存。", "从今若许闲乘月，", "拄杖无时夜叩门。"],
    "tags": ["田园", "友情", "山水"],
    "level": 3
  },
  {
    "title": "十一月四日风雨大作",
    "author": "陆游",
    "dynasty": "宋",
    "lines": ["僵卧孤村不自哀，", "尚思为国戍轮台。", "夜阑卧听风吹雨，", "铁马冰河入梦来。"],
    "tags": ["励志", "雨", "冬天"],
    "level": 3
  },
  {
    "title": "沈园",
    "author": "陆游",
    "dynasty": "宋",
    "lines": ["城上斜阳画角哀，", "沈园非复旧池台。", "伤心桥下春波绿，", "曾是惊鸿照影来。"],
    "tags": ["春天", "花"],
    "level": 3
  },
  {
    "title": "临安春雨初霁",
    "author": "陆游",
    "dynasty": "宋",
    "lines": ["世味年来薄似纱，", "谁令骑马客京华。", "小楼一夜听春雨，", "深巷明朝卖杏花。", "矮纸斜行闲作草，", "晴窗细乳戏分茶。", "素衣莫起风尘叹，", "犹及清明可到家。"],
    "tags": ["春天", "雨", "花"],
    "level": 3
  },
  {
    "title": "晓出净慈寺送林子方",
    "author": "杨万里",
    "dynasty": "宋",
    "lines": ["毕竟西湖六月中，", "风光不与四时同。", "接天莲叶无穷碧，", "映日荷花别样红。"],
    "tags": ["夏天", "花", "送别"],
    "level": 2
  },
  {
    "title": "宿新市徐公店",
    "author": "杨万里",
    "dynasty": "宋",
    "lines": ["篱落疏疏一径深，", "树头花落未成阴。", "儿童急走追黄蝶，", "飞入菜花无处寻。"],
    "tags": ["童趣", "春天", "动物"],
    "level": 2
  },
  {
    "title": "闲居初夏午睡起",
    "author": "杨万里",
    "dynasty": "宋",
    "lines": ["梅子留酸软齿牙，", "芭蕉分绿与窗纱。", "日长睡起无情思，", "闲看儿童捉柳花。"],
    "tags": ["夏天", "童趣", "植物"],
    "level": 2
  },
  {
    "title": "新柳",
    "author": "杨万里",
    "dynasty": "宋",
    "lines": ["柳条百尺拂银塘，", "且莫深青只浅黄。", "未必柳条能蘸水，", "水中柳影引他长。"],
    "tags": ["春天", "植物"],
    "level": 2
  },
  {
    "title": "稚子弄冰",
    "author": "杨万里",
    "dynasty": "宋",
    "lines": ["稚子金盆脱晓冰，", "彩丝穿取当银钲。", "敲成玉磬穿林响，", "忽作玻璃碎地声。"],
    "tags": ["冬天", "童趣"],
    "level": 2
  },
  {
    "title": "舟过安仁",
    "author": "杨万里",
    "dynasty": "宋",
    "lines": ["一叶渔船两小童，", "收篙停棹坐船中。", "怪生无雨都张伞，", "不是遮头是使风。"],
    "tags": ["童趣", "夏天"],
    "level": 2
  },
  {
    "title": "桑茶坑道中",
    "author": "杨万里",
    "dynasty": "宋",
    "lines": ["晴明风日雨干时，", "草满花堤水满溪。", "童子柳阴眠正着，", "一牛吃过柳阴西。"],
    "tags": ["夏天", "童趣", "动物"],
    "level": 2
  },
  {
    "title": "夏夜追凉",
    "author": "杨万里",
    "dynasty": "宋",
    "lines": ["夜热依然午热同，", "开门小立月明中。", "竹深树密虫鸣处，", "时有微凉不是风。"],
    "tags": ["夏天", "月亮"],
    "level": 2
  },
  {
    "title": "过松源晨炊漆公店",
    "author": "杨万里",
    "dynasty": "宋",
    "lines": ["莫言下岭便无难，", "赚得行人错喜欢。", "正入万山圈子里，", "一山放出一山拦。"],
    "tags": ["山水", "励志"],
    "level": 2
  },
  {
    "title": "闲居初夏午睡起·其二",
    "author": "杨万里",
    "dynasty": "宋",
    "lines": ["松阴一架半弓苔，", "偶欲看书又懒开。", "戏掬清泉洒蕉叶，", "儿童误认雨声来。"],
    "tags": ["夏天", "童趣", "植物"],
    "level": 2
  },
  {
    "title": "最爱东山晴后雪",
    "author": "杨万里",
    "dynasty": "宋",
    "lines": ["只知逐胜忽忘寒，", "小立春风夕照间。", "最爱东山晴后雪，", "软红光里涌银山。"],
    "tags": ["冬天", "雪", "山水"],
    "level": 2
  },
  {
    "title": "四时田园杂兴·其一",
    "author": "范成大",
    "dynasty": "宋",
    "lines": ["昼出耘田夜绩麻，", "村庄儿女各当家。", "童孙未解供耕织，", "也傍桑阴学种瓜。"],
    "tags": ["田园", "童趣", "夏天"],
    "level": 2
  },
  {
    "title": "四时田园杂兴·其二",
    "author": "范成大",
    "dynasty": "宋",
    "lines": ["梅子金黄杏子肥，", "麦花雪白菜花稀。", "日长篱落无人过，", "惟有蜻蜓蛱蝶飞。"],
    "tags": ["夏天", "植物", "田园"],
    "level": 2
  },
  {
    "title": "州桥",
    "author": "范成大",
    "dynasty": "宋",
    "lines": ["州桥南北是天街，", "父老年年等驾回。", "忍泪失声询使者，", "几时真有六军来。"],
    "tags": ["思乡", "励志"],
    "level": 3
  },
  {
    "title": "横塘",
    "author": "范成大",
    "dynasty": "宋",
    "lines": ["南浦春来绿一川，", "石桥朱塔两依然。", "年年送客横塘路，", "细雨垂杨系画船。"],
    "tags": ["送别", "春天", "山水"],
    "level": 2
  },
  {
    "title": "春日",
    "author": "朱熹",
    "dynasty": "宋",
    "lines": ["胜日寻芳泗水滨，", "无边光景一时新。", "等闲识得东风面，", "万紫千红总是春。"],
    "tags": ["春天", "花", "励志"],
    "level": 2
  },
  {
    "title": "观书有感",
    "author": "朱熹",
    "dynasty": "宋",
    "lines": ["半亩方塘一鉴开，", "天光云影共徘徊。", "问渠那得清如许，", "为有源头活水来。"],
    "tags": ["读书", "山水", "励志"],
    "level": 2
  },
  {
    "title": "观书有感·其二",
    "author": "朱熹",
    "dynasty": "宋",
    "lines": ["昨夜江边春水生，", "蒙冲巨舰一毛轻。", "向来枉费推移力，", "此日中流自在行。"],
    "tags": ["读书", "励志", "山水"],
    "level": 2
  },
  {
    "title": "偶成",
    "author": "朱熹",
    "dynasty": "宋",
    "lines": ["少年易老学难成，", "一寸光阴不可轻。", "未觉池塘春草梦，", "阶前梧叶已秋声。"],
    "tags": ["读书", "时间", "励志"],
    "level": 2
  },
  {
    "title": "西江月·夜行黄沙道中",
    "author": "辛弃疾",
    "dynasty": "宋",
    "lines": ["明月别枝惊鹊，", "清风半夜鸣蝉。", "稻花香里说丰年，", "听取蛙声一片。", "七八个星天外，", "两三点雨山前。", "旧时茅店社林边，", "路转溪桥忽见。"],
    "tags": ["夏天", "月亮", "田园"],
    "level": 2
  },
  {
    "title": "清平乐·村居",
    "author": "辛弃疾",
    "dynasty": "宋",
    "lines": ["茅檐低小，", "溪上青青草。", "醉里吴音相媚好，", "白发谁家翁媪？", "大儿锄豆溪东，", "中儿正织鸡笼。", "最喜小儿亡赖，", "溪头卧剥莲蓬。"],
    "tags": ["田园", "童趣", "夏天"],
    "level": 2
  },
  {
    "title": "如梦令·常记溪亭日暮",
    "author": "李清照",
    "dynasty": "宋",
    "lines": ["常记溪亭日暮，", "沉醉不知归路。", "兴尽晚回舟，", "误入藕花深处。", "争渡，", "争渡，", "惊起一滩鸥鹭。"],
    "tags": ["夏天", "花", "童趣"],
    "level": 2
  },
  {
    "title": "如梦令·昨夜雨疏风骤",
    "author": "李清照",
    "dynasty": "宋",
    "lines": ["昨夜雨疏风骤，", "浓睡不消残酒。", "试问卷帘人，", "却道海棠依旧。", "知否，", "知否，", "应是绿肥红瘦。"],
    "tags": ["花", "春天", "雨"],
    "level": 2
  },
  {
    "title": "夏日绝句",
    "author": "李清照",
    "dynasty": "宋",
    "lines": ["生当作人杰，", "死亦为鬼雄。", "至今思项羽，", "不肯过江东。"],
    "tags": ["励志", "夏天"],
    "level": 2
  },
  {
    "title": "游园不值",
    "author": "叶绍翁",
    "dynasty": "宋",
    "lines": ["应怜屐齿印苍苔，", "小扣柴扉久不开。", "春色满园关不住，", "一枝红杏出墙来。"],
    "tags": ["春天", "花", "植物"],
    "level": 2
  },
  {
    "title": "三衢道中",
    "author": "曾几",
    "dynasty": "宋",
    "lines": ["梅子黄时日日晴，", "小溪泛尽却山行。", "绿阴不减来时路，", "添得黄鹂四五声。"],
    "tags": ["夏天", "山水", "动物"],
    "level": 2
  },
  {
    "title": "乡村四月",
    "author": "翁卷",
    "dynasty": "宋",
    "lines": ["绿遍山原白满川，", "子规声里雨如烟。", "乡村四月闲人少，", "才了蚕桑又插田。"],
    "tags": ["夏天", "田园", "雨"],
    "level": 2
  },
  {
    "title": "村晚",
    "author": "雷震",
    "dynasty": "宋",
    "lines": ["草满池塘水满陂，", "山衔落日浸寒漪。", "牧童归去横牛背，", "短笛无腔信口吹。"],
    "tags": ["夏天", "童趣", "田园"],
    "level": 2
  },
  {
    "title": "绝句·古木阴中系短篷",
    "author": "志南",
    "dynasty": "宋",
    "lines": ["古木阴中系短篷，", "杖藜扶我过桥东。", "沾衣欲湿杏花雨，", "吹面不寒杨柳风。"],
    "tags": ["春天", "雨", "植物"],
    "level": 2
  },
  {
    "title": "题临安邸",
    "author": "林升",
    "dynasty": "宋",
    "lines": ["山外青山楼外楼，", "西湖歌舞几时休。", "暖风熏得游人醉，", "直把杭州作汴州。"],
    "tags": ["励志", "山水", "思乡"],
    "level": 3
  },
  {
    "title": "雪梅·其一",
    "author": "卢梅坡",
    "dynasty": "宋",
    "lines": ["梅雪争春未肯降，", "骚人阁笔费评章。", "梅须逊雪三分白，", "雪却输梅一段香。"],
    "tags": ["冬天", "雪", "花"],
    "level": 2
  },
  {
    "title": "雪梅·其二",
    "author": "卢梅坡",
    "dynasty": "宋",
    "lines": ["有梅无雪不精神，", "有雪无诗俗了人。", "日暮诗成天又雪，", "与梅并作十分春。"],
    "tags": ["冬天", "雪", "花"],
    "level": 2
  },
  {
    "title": "社日",
    "author": "王驾",
    "dynasty": "宋",
    "lines": ["鹅湖山下稻粱肥，", "豚栅鸡栖半掩扉。", "桑柘影斜春社散，", "家家扶得醉人归。"],
    "tags": ["田园", "节日", "春天"],
    "level": 2
  },
  {
    "title": "雨晴",
    "author": "王驾",
    "dynasty": "宋",
    "lines": ["雨前初见花间蕊，", "雨后兼无叶底花。", "蜂蝶纷纷过墙去，", "却疑春色在邻家。"],
    "tags": ["春天", "花", "动物"],
    "level": 2
  },
  {
    "title": "春日偶成",
    "author": "程颢",
    "dynasty": "宋",
    "lines": ["云淡风轻近午天，", "傍花随柳过前川。", "时人不识余心乐，", "将谓偷闲学少年。"],
    "tags": ["春天", "山水", "励志"],
    "level": 2
  },
  {
    "title": "秋日",
    "author": "程颢",
    "dynasty": "宋",
    "lines": ["闲来无事不从容，", "睡觉东窗日已红。", "万物静观皆自得，", "四时佳兴与人同。", "道通天地有形外，", "思入风云变态中。", "富贵不淫贫贱乐，", "男儿到此是豪雄。"],
    "tags": ["秋天", "励志", "山水"],
    "level": 3
  },
  {
    "title": "江上渔者",
    "author": "范仲淹",
    "dynasty": "宋",
    "lines": ["江上往来人，", "但爱鲈鱼美。", "君看一叶舟，", "出没风波里。"],
    "tags": ["动物", "励志"],
    "level": 2
  },
  {
    "title": "客中初夏",
    "author": "司马光",
    "dynasty": "宋",
    "lines": ["四月清和雨乍晴，", "南山当户转分明。", "更无柳絮因风起，", "惟有葵花向日倾。"],
    "tags": ["夏天", "植物", "山水"],
    "level": 2
  },
  {
    "title": "牧童诗",
    "author": "黄庭坚",
    "dynasty": "宋",
    "lines": ["骑牛远远过前村，", "吹笛风斜隔陇闻。", "多少长安名利客，", "机关用尽不如君。"],
    "tags": ["童趣", "励志"],
    "level": 2
  },
  {
    "title": "蚕妇",
    "author": "张俞",
    "dynasty": "宋",
    "lines": ["昨日入城市，", "归来泪满巾。", "遍身罗绮者，", "不是养蚕人。"],
    "tags": ["田园", "励志"],
    "level": 2
  },
  {
    "title": "雨后池上",
    "author": "刘攽",
    "dynasty": "宋",
    "lines": ["一雨池塘水面平，", "淡磨明镜照檐楹。", "东风忽起垂杨舞，", "更作荷心万点声。"],
    "tags": ["雨", "夏天", "山水"],
    "level": 2
  },
  {
    "title": "春游湖",
    "author": "徐俯",
    "dynasty": "宋",
    "lines": ["双飞燕子几时回？", "夹岸桃花蘸水开。", "春雨断桥人不度，", "小舟撑出柳阴来。"],
    "tags": ["春天", "雨", "动物"],
    "level": 2
  },
  {
    "title": "约客",
    "author": "赵师秀",
    "dynasty": "宋",
    "lines": ["黄梅时节家家雨，", "青草池塘处处蛙。", "有约不来过夜半，", "闲敲棋子落灯花。"],
    "tags": ["夏天", "雨", "动物"],
    "level": 2
  },
  {
    "title": "暮春即事",
    "author": "叶采",
    "dynasty": "宋",
    "lines": ["双双瓦雀行书案，", "点点杨花入砚池。", "闲坐小窗读周易，", "不知春去几多时。"],
    "tags": ["读书", "春天", "童趣"],
    "level": 2
  },
  {
    "title": "寒夜",
    "author": "杜耒",
    "dynasty": "宋",
    "lines": ["寒夜客来茶当酒，", "竹炉汤沸火初红。", "寻常一样窗前月，", "才有梅花便不同。"],
    "tags": ["冬天", "友情", "花"],
    "level": 2
  },
  {
    "title": "淮中晚泊犊头",
    "author": "苏舜钦",
    "dynasty": "宋",
    "lines": ["春阴垂野草青青，", "时有幽花一树明。", "晚泊孤舟古祠下，", "满川风雨看潮生。"],
    "tags": ["春天", "雨", "山水"],
    "level": 2
  },
  {
    "title": "画眉鸟",
    "author": "欧阳修",
    "dynasty": "宋",
    "lines": ["百啭千声随意移，", "山花红紫树高低。", "始知锁向金笼听，", "不及林间自在啼。"],
    "tags": ["动物", "励志", "山水"],
    "level": 2
  },
  {
    "title": "丰乐亭游春",
    "author": "欧阳修",
    "dynasty": "宋",
    "lines": ["红树青山日欲斜，", "长郊草色绿无涯。", "游人不管春将老，", "来往亭前踏落花。"],
    "tags": ["春天", "花", "山水"],
    "level": 2
  },
  {
    "title": "襄邑道中",
    "author": "陈与义",
    "dynasty": "宋",
    "lines": ["飞花两岸照船红，", "百里榆堤半日风。", "卧看满天云不动，", "不知云与我俱东。"],
    "tags": ["春天", "山水", "励志"],
    "level": 2
  },
  {
    "title": "临平道中",
    "author": "道潜",
    "dynasty": "宋",
    "lines": ["风蒲猎猎弄轻柔，", "欲立蜻蜓不自由。", "五月临平山下路，", "藕花无数满汀洲。"],
    "tags": ["夏天", "植物", "山水"],
    "level": 2
  },
  {
    "title": "送春",
    "author": "王令",
    "dynasty": "宋",
    "lines": ["三月残花落更开，", "小檐日日燕飞来。", "子规夜半犹啼血，", "不信东风唤不回。"],
    "tags": ["春天", "动物", "励志"],
    "level": 2
  },
  {
    "title": "寒菊",
    "author": "郑思肖",
    "dynasty": "宋",
    "lines": ["花开不并百花丛，", "独立疏篱趣未穷。", "宁可枝头抱香死，", "何曾吹落北风中。"],
    "tags": ["冬天", "花", "植物"],
    "level": 2
  },
  {
    "title": "立春偶成",
    "author": "张栻",
    "dynasty": "宋",
    "lines": ["律回岁晚冰霜少，", "春到人间草木知。", "便觉眼前生意满，", "东风吹水绿参差。"],
    "tags": ["春天", "冬天", "励志"],
    "level": 2
  },
  {
    "title": "立秋",
    "author": "刘翰",
    "dynasty": "宋",
    "lines": ["乳鸦啼散玉屏空，", "一枕新凉一扇风。", "睡起秋声无觅处，", "满阶梧叶月明中。"],
    "tags": ["秋天", "时间", "月亮"],
    "level": 2
  },
  {
    "title": "江南春",
    "author": "寇准",
    "dynasty": "宋",
    "lines": ["波渺渺，", "柳依依。", "孤村芳草远，", "斜日杏花飞。"],
    "tags": ["春天", "山水", "思乡"],
    "level": 1
  },
  {
    "title": "清明",
    "author": "王禹偁",
    "dynasty": "宋",
    "lines": ["无花无酒过清明，", "兴味萧然似野僧。", "昨日邻家乞新火，", "晓窗分与读书灯。"],
    "tags": ["春天", "读书", "节日"],
    "level": 2
  },
  {
    "title": "陶者",
    "author": "梅尧臣",
    "dynasty": "宋",
    "lines": ["陶尽门前土，", "屋上无片瓦。", "十指不沾泥，", "鳞鳞居大厦。"],
    "tags": ["励志", "田园"],
    "level": 2
  },
  {
    "title": "咏柳",
    "author": "曾巩",
    "dynasty": "宋",
    "lines": ["乱条犹未变初黄，", "倚得东风势便狂。", "解把飞花蒙日月，", "不知天地有清霜。"],
    "tags": ["春天", "植物", "励志"],
    "level": 2
  },
  {
    "title": "夜书所见",
    "author": "叶绍翁",
    "dynasty": "宋",
    "lines": ["萧萧梧叶送寒声，", "江上秋风动客情。", "知有儿童挑促织，", "夜深篱落一灯明。"],
    "tags": ["秋天", "思乡", "童趣"],
    "level": 2
  },
  {
    "title": "春日",
    "author": "秦观",
    "dynasty": "宋",
    "lines": ["一夕轻雷落万丝，", "霁光浮瓦碧参差。", "有情芍药含春泪，", "无力蔷薇卧晓枝。"],
    "tags": ["春天", "雨", "花"],
    "level": 2
  },
  {
    "title": "卜算子·送鲍浩然之浙东",
    "author": "王观",
    "dynasty": "宋",
    "lines": ["水是眼波横，", "山是眉峰聚。", "欲问行人去那边，", "眉眼盈盈处。", "才始送春归，", "又送君归去。", "若到江南赶上春，", "千万和春住。"],
    "tags": ["送别", "春天", "山水"],
    "level": 2
  },
  {
    "title": "数日",
    "author": "赵师秀",
    "dynasty": "宋",
    "lines": ["数日秋风欺病夫，", "尽吹黄叶下庭芜。", "林疏放得遥山出，", "又被云遮一半无。"],
    "tags": ["秋天", "山水"],
    "level": 2
  }
]
