[
  {
    "title": "鹿柴",
    "author": "王维",
    "dynasty": "唐",
    "lines": ["空山不见人，", "但闻人语响。", "返景入深林，", "复照青苔上。"],
    "tags": ["山水", "田园"],
    "level": 2
  },
  {
    "title": "竹里馆",
    "author": "王维",
    "dynasty": "唐",
    "lines": ["独坐幽篁里，", "弹琴复长啸。", "深林人不知，", "明月来相照。"],
    "tags": ["山水", "田园"],
    "level": 2
  },
  {
    "title": "送元二使安西",
    "author": "王维",
    "dynasty": "唐",
    "lines": ["渭城朝雨浥轻尘，", "客舍青青柳色新。", "劝君更尽一杯酒，", "西出阳关无故人。"],
    "tags": ["送别", "友情"],
    "level": 2
  },
  {
    "title": "鸟鸣涧",
    "author": "王维",
    "dynasty": "唐",
    "lines": ["人闲桂花落，", "夜静春山空。", "月出惊山鸟，", "时鸣春涧中。"],
    "tags": ["春天", "山水"],
    "level": 2
  },
  {
    "title": "杂诗",
    "author": "王维",
    "dynasty": "唐",
    "lines": ["君自故乡来，", "应知故乡事。", "来日绮窗前，", "寒梅著花未。"],
    "tags": ["思乡", "植物"],
    "level": 2
  },
  {
    "title": "山中",
    "author": "王维",
    "dynasty": "唐",
    "lines": ["荆溪白石出，", "天寒红叶稀。", "山路元无雨，", "空翠湿人衣。"],
    "tags": ["山水", "秋天"],
    "level": 2
  },
  {
    "title": "田园乐",
    "author": "王维",
    "dynasty": "唐",
    "lines": ["桃红复含宿雨，", "柳绿更带朝烟。", "花落家童未扫，", "莺啼山客犹眠。"],
    "tags": ["田园", "春天"],
    "level": 2
  },
  {
    "title": "辛夷坞",
    "author": "王维",
    "dynasty": "唐",
    "lines": ["木末芙蓉花，", "山中发红萼。", "涧户寂无人，", "纷纷开且落。"],
    "tags": ["植物", "山水"],
    "level": 2
  },
  {
    "title": "莲花坞",
    "author": "王维",
    "dynasty": "唐",
    "lines": ["日日采莲去，", "洲长多暮归。", "弄篙莫溅水，", "畏湿红莲衣。"],
    "tags": ["植物", "夏天"],
    "level": 2
  },
  {
    "title": "白石滩",
    "author": "王维",
    "dynasty": "唐",
    "lines": ["清浅白石滩，", "绿蒲向堪把。", "家住水东西，", "浣纱明月下。"],
    "tags": ["山水", "植物"],
    "level": 2
  },
  {
    "title": "宿建德江",
    "author": "孟浩然",
    "dynasty": "唐",
    "lines": ["移舟泊烟渚，", "日暮客愁新。", "野旷天低树，", "江清月近人。"],
    "tags": ["思乡", "月亮"],
    "level": 2
  },
  {
    "title": "过故人庄",
    "author": "孟浩然",
    "dynasty": "唐",
    "lines": ["故人具鸡黍，", "邀我至田家。", "绿树村边合，", "青山郭外斜。", "开轩面场圃，", "把酒话桑麻。", "待到重阳日，", "还来就菊花。"],
    "tags": ["田园", "友情"],
    "level": 2
  },
  {
    "title": "望洞庭湖赠张丞相",
    "author": "孟浩然",
    "dynasty": "唐",
    "lines": ["八月湖水平，", "涵虚混太清。", "气蒸云梦泽，", "波撼岳阳城。", "欲济无舟楫，", "端居耻圣明。", "坐观垂钓者，", "徒有羡鱼情。"],
    "tags": ["山水", "励志"],
    "level": 2
  },
  {
    "title": "渡浙江问舟中人",
    "author": "孟浩然",
    "dynasty": "唐",
    "lines": ["潮落江平未有风，", "扁舟共济与君同。", "时时引领望天末，", "何处青山是越中。"],
    "tags": ["山水", "思乡"],
    "level": 2
  },
  {
    "title": "送朱大入秦",
    "author": "孟浩然",
    "dynasty": "唐",
    "lines": ["游人五陵去，", "宝剑值千金。", "分手脱相赠，", "平生一片心。"],
    "tags": ["送别", "友情"],
    "level": 2
  },
  {
    "title": "岁暮归南山",
    "author": "孟浩然",
    "dynasty": "唐",
    "lines": ["北阙休上书，", "南山归敝庐。", "不才明主弃，", "多病故人疏。", "白发催年老，", "青阳逼岁除。", "永怀愁不寐，", "松月夜窗虚。"],
    "tags": ["思乡", "时间"],
    "level": 3
  },
  {
    "title": "独坐敬亭山",
    "author": "李白",
    "dynasty": "唐",
    "lines": ["众鸟高飞尽，", "孤云独去闲。", "相看两不厌，", "只有敬亭山。"],
    "tags": ["山水", "励志"],
    "level": 2
  },
  {
    "title": "秋浦歌",
    "author": "李白",
    "dynasty": "唐",
    "lines": ["白发三千丈，", "缘愁似个长。", "不知明镜里，", "何处得秋霜。"],
    "tags": ["时间", "秋天"],
    "level": 2
  },
  {
    "title": "赠汪伦",
    "author": "李白",
    "dynasty": "唐",
    "lines": ["李白乘舟将欲行，", "忽闻岸上踏歌声。", "桃花潭水深千尺，", "不及汪伦送我情。"],
    "tags": ["友情", "送别"],
    "level": 2
  },
  {
    "title": "黄鹤楼送孟浩然之广陵",
    "author": "李白",
    "dynasty": "唐",
    "lines": ["故人西辞黄鹤楼，", "烟花三月下扬州。", "孤帆远影碧空尽，", "唯见长江天际流。"],
    "tags": ["送别", "友情"],
    "level": 2
  },
  {
    "title": "夜宿山寺",
    "author": "李白",
    "dynasty": "唐",
    "lines": ["危楼高百尺，", "手可摘星辰。", "不敢高声语，", "恐惊天上人。"],
    "tags": ["山水", "励志"],
    "level": 1
  },
  {
    "title": "客中作",
    "author": "李白",
    "dynasty": "唐",
    "lines": ["兰陵美酒郁金香，", "玉碗盛来琥珀光。", "但使主人能醉客，", "不知何处是他乡。"],
    "tags": ["思乡", "友情"],
    "level": 2
  },
  {
    "title": "玉阶怨",
    "author": "李白",
    "dynasty": "唐",
    "lines": ["玉阶生白露，", "夜久侵罗袜。", "却下水晶帘，", "玲珑望秋月。"],
    "tags": ["思乡", "月亮"],
    "level": 2
  },
  {
    "title": "劳劳亭",
    "author": "李白",
    "dynasty": "唐",
    "lines": ["天下伤心处，", "劳劳送客亭。", "春风知别苦，", "不遣柳条青。"],
    "tags": ["送别", "春天"],
    "level": 2
  },
  {
    "title": "山中问答",
    "author": "李白",
    "dynasty": "唐",
    "lines": ["问余何意栖碧山，", "笑而不答心自闲。", "桃花流水窅然去，", "别有天地非人间。"],
    "tags": ["山水", "励志"],
    "level": 2
  },
  {
    "title": "峨眉山月歌",
    "author": "李白",
    "dynasty": "唐",
    "lines": ["峨眉山月半轮秋，", "影入平羌江水流。", "夜发清溪向三峡，", "思君不见下渝州。"],
    "tags": ["月亮", "山水"],
    "level": 2
  },
  {
    "title": "春夜洛城闻笛",
    "author": "李白",
    "dynasty": "唐",
    "lines": ["谁家玉笛暗飞声，", "散入春风满洛城。", "此夜曲中闻折柳，", "何人不起故园情。"],
    "tags": ["思乡", "春天"],
    "level": 2
  },
  {
    "title": "江畔独步寻花",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": ["黄四娘家花满蹊，", "千朵万朵压枝低。", "留连戏蝶时时舞，", "自在娇莺恰恰啼。"],
    "tags": ["花", "春天"],
    "level": 2
  },
  {
    "title": "迟日江山丽",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": ["迟日江山丽，", "春风花草香。", "泥融飞燕子，", "沙暖睡鸳鸯。"],
    "tags": ["春天", "动物"],
    "level": 2
  },
  {
    "title": "八阵图",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": ["功盖三分国，", "名成八阵图。", "江流石不转，", "遗恨失吞吴。"],
    "tags": ["励志", "时间"],
    "level": 2
  },
  {
    "title": "江南逢李龟年",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": ["岐王宅里寻常见，", "崔九堂前几度闻。", "正是江南好风景，", "落花时节又逢君。"],
    "tags": ["友情", "春天"],
    "level": 2
  },
  {
    "title": "春望",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": ["国破山河在，", "城春草木深。", "感时花溅泪，", "恨别鸟惊心。", "烽火连三月，", "家书抵万金。", "白头搔更短，", "浑欲不胜簪。"],
    "tags": ["思乡", "春天"],
    "level": 3
  },
  {
    "title": "赠花卿",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": ["锦城丝管日纷纷，", "半入江风半入云。", "此曲只应天上有，", "人间能得几回闻。"],
    "tags": ["友情", "春天"],
    "level": 2
  },
  {
    "title": "江碧鸟逾白",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": ["江碧鸟逾白，", "山青花欲燃。", "今春看又过，", "何日是归年。"],
    "tags": ["思乡", "春天"],
    "level": 2
  },
  {
    "title": "登岳阳楼",
    "author": "杜甫",
    "dynasty": "唐",
    "lines": ["昔闻洞庭水，", "今上岳阳楼。", "吴楚东南坼，", "乾坤日夜浮。", "亲朋无一字，", "老病有孤舟。", "戎马关山北，", "凭轩涕泗流。"],
    "tags": ["思乡", "山水"],
    "level": 3
  },
  {
    "title": "忆江南",
    "author": "白居易",
    "dynasty": "唐",
    "lines": ["江南好，", "风景旧曾谙。", "日出江花红胜火，", "春来江水绿如蓝。", "能不忆江南？"],
    "tags": ["春天", "山水"],
    "level": 1
  },
  {
    "title": "暮江吟",
    "author": "白居易",
    "dynasty": "唐",
    "lines": ["一道残阳铺水中，", "半江瑟瑟半江红。", "可怜九月初三夜，", "露似真珠月似弓。"],
    "tags": ["秋天", "山水"],
    "level": 2
  },
  {
    "title": "大林寺桃花",
    "author": "白居易",
    "dynasty": "唐",
    "lines": ["人间四月芳菲尽，", "山寺桃花始盛开。", "长恨春归无觅处，", "不知转入此中来。"],
    "tags": ["花", "春天"],
    "level": 2
  },
  {
    "title": "遗爱寺",
    "author": "白居易",
    "dynasty": "唐",
    "lines": ["弄石临溪坐，", "寻花绕寺行。", "时时闻鸟语，", "处处是泉声。"],
    "tags": ["山水", "动物"],
    "level": 1
  },
  {
    "title": "钱塘湖春行",
    "author": "白居易",
    "dynasty": "唐",
    "lines": ["孤山寺北贾亭西，", "水面初平云脚低。", "几处早莺争暖树，", "谁家新燕啄春泥。", "乱花渐欲迷人眼，", "浅草才能没马蹄。", "最爱湖东行不足，", "绿杨阴里白沙堤。"],
    "tags": ["春天", "山水"],
    "level": 2
  },
  {
    "title": "问刘十九",
    "author": "白居易",
    "dynasty": "唐",
    "lines": ["绿蚁新醅酒，", "红泥小火炉。", "晚来天欲雪，", "能饮一杯无？"],
    "tags": ["友情", "雪"],
    "level": 2
  },
  {
    "title": "浪淘沙",
    "author": "白居易",
    "dynasty": "唐",
    "lines": ["白浪茫茫与海连，", "平沙浩浩四无边。", "暮去朝来淘不住，", "遂令东海变桑田。"],
    "tags": ["山水", "时间"],
    "level": 2
  },
  {
    "title": "秋夕",
    "author": "杜牧",
    "dynasty": "唐",
    "lines": ["银烛秋光冷画屏，", "轻罗小扇扑流萤。", "天阶夜色凉如水，", "卧看牵牛织女星。"],
    "tags": ["秋天", "月亮"],
    "level": 2
  },
  {
    "title": "泊秦淮",
    "author": "杜牧",
    "dynasty": "唐",
    "lines": ["烟笼寒水月笼沙，", "夜泊秦淮近酒家。", "商女不知亡国恨，", "隔江犹唱后庭花。"],
    "tags": ["秋天", "月亮"],
    "level": 3
  },
  {
    "title": "寄扬州韩绰判官",
    "author": "杜牧",
    "dynasty": "唐",
    "lines": ["青山隐隐水迢迢，", "秋尽江南草未凋。", "二十四桥明月夜，", "玉人何处教吹箫。"],
    "tags": ["秋天", "月亮"],
    "level": 2
  },
  {
    "title": "赠别",
    "author": "杜牧",
    "dynasty": "唐",
    "lines": ["娉娉袅袅十三余，", "豆蔻梢头二月初。", "春风十里扬州路，", "卷上珠帘总不如。"],
    "tags": ["送别", "友情"],
    "level": 2
  },
  {
    "title": "江南春",
    "author": "杜牧",
    "dynasty": "唐",
    "lines": ["千里莺啼绿映红，", "水村山郭酒旗风。", "南朝四百八十寺，", "多少楼台烟雨中。"],
    "tags": ["春天", "雨"],
    "level": 2
  },
  {
    "title": "过华清宫",
    "author": "杜牧",
    "dynasty": "唐",
    "lines": ["长安回望绣成堆，", "山顶千门次第开。", "一骑红尘妃子笑，", "无人知是荔枝来。"],
    "tags": ["动物", "花"],
    "level": 2
  },
  {
    "title": "题乌江亭",
    "author": "杜牧",
    "dynasty": "唐",
    "lines": ["胜败兵家事不期，", "包羞忍耻是男儿。", "江东子弟多才俊，", "卷土重来未可知。"],
    "tags": ["励志", "时间"],
    "level": 2
  },
  {
    "title": "夜雨寄北",
    "author": "李商隐",
    "dynasty": "唐",
    "lines": ["君问归期未有期，", "巴山夜雨涨秋池。", "何当共剪西窗烛，", "却话巴山夜雨时。"],
    "tags": ["思乡", "雨"],
    "level": 2
  },
  {
    "title": "登乐游原",
    "author": "李商隐",
    "dynasty": "唐",
    "lines": ["向晚意不适，", "驱车登古原。", "夕阳无限好，", "只是近黄昏。"],
    "tags": ["时间", "秋天"],
    "level": 2
  },
  {
    "title": "嫦娥",
    "author": "李商隐",
    "dynasty": "唐",
    "lines": ["云母屏风烛影深，", "长河渐落晓星沉。", "嫦娥应悔偷灵药，", "碧海青天夜夜心。"],
    "tags": ["月亮", "秋天"],
    "level": 2
  },
  {
    "title": "霜月",
    "author": "李商隐",
    "dynasty": "唐",
    "lines": ["初闻征雁已无蝉，", "百尺楼高水接天。", "青女素娥俱耐冷，", "月中霜里斗婵娟。"],
    "tags": ["月亮", "秋天"],
    "level": 2
  },
  {
    "title": "宿骆氏亭寄怀崔雍崔衮",
    "author": "李商隐",
    "dynasty": "唐",
    "lines": ["竹坞无尘水槛清，", "相思迢递隔重城。", "秋阴不散霜飞晚，", "留得枯荷听雨声。"],
    "tags": ["秋天", "雨"],
    "level": 2
  },
  {
    "title": "贾生",
    "author": "李商隐",
    "dynasty": "唐",
    "lines": ["宣室求贤访逐臣，", "贾生才调更无伦。", "可怜夜半虚前席，", "不问苍生问鬼神。"],
    "tags": ["励志", "时间"],
    "level": 3
  },
  {
    "title": "芙蓉楼送辛渐",
    "author": "王昌龄",
    "dynasty": "唐",
    "lines": ["寒雨连江夜入吴，", "平明送客楚山孤。", "洛阳亲友如相问，", "一片冰心在玉壶。"],
    "tags": ["送别", "友情"],
    "level": 2
  },
  {
    "title": "出塞",
    "author": "王昌龄",
    "dynasty": "唐",
    "lines": ["秦时明月汉时关，", "万里长征人未还。", "但使龙城飞将在，", "不教胡马度阴山。"],
    "tags": ["边塞", "月亮"],
    "level": 2
  },
  {
    "title": "从军行",
    "author": "王昌龄",
    "dynasty": "唐",
    "lines": ["青海长云暗雪山，", "孤城遥望玉门关。", "黄沙百战穿金甲，", "不破楼兰终不还。"],
    "tags": ["边塞", "励志"],
    "level": 2
  },
  {
    "title": "从军行其五",
    "author": "王昌龄",
    "dynasty": "唐",
    "lines": ["大漠风尘日色昏，", "红旗半卷出辕门。", "前军夜战洮河北，", "已报生擒吐谷浑。"],
    "tags": ["边塞", "励志"],
    "level": 2
  },
  {
    "title": "闺怨",
    "author": "王昌龄",
    "dynasty": "唐",
    "lines": ["闺中少妇不知愁，", "春日凝妆上翠楼。", "忽见陌头杨柳色，", "悔教夫婿觅封侯。"],
    "tags": ["思乡", "春天"],
    "level": 2
  },
  {
    "title": "采莲曲",
    "author": "王昌龄",
    "dynasty": "唐",
    "lines": ["荷叶罗裙一色裁，", "芙蓉向脸两边开。", "乱入池中看不见，", "闻歌始觉有人来。"],
    "tags": ["植物", "夏天"],
    "level": 2
  },
  {
    "title": "逢入京使",
    "author": "岑参",
    "dynasty": "唐",
    "lines": ["故园东望路漫漫，", "双袖龙钟泪不干。", "马上相逢无纸笔，", "凭君传语报平安。"],
    "tags": ["思乡", "送别"],
    "level": 2
  },
  {
    "title": "碛中作",
    "author": "岑参",
    "dynasty": "唐",
    "lines": ["走马西来欲到天，", "辞家见月两回圆。", "今夜不知何处宿，", "平沙万里绝人烟。"],
    "tags": ["思乡", "边塞"],
    "level": 2
  },
  {
    "title": "山房春事",
    "author": "岑参",
    "dynasty": "唐",
    "lines": ["梁园日暮乱飞鸦，", "极目萧条三两家。", "庭树不知人去尽，", "春来还发旧时花。"],
    "tags": ["春天", "花"],
    "level": 2
  },
  {
    "title": "戏问花门酒家翁",
    "author": "岑参",
    "dynasty": "唐",
    "lines": ["老人七十仍沽酒，", "千壶百瓮花门口。", "道傍榆荚仍似钱，", "摘来沽酒君肯否？"],
    "tags": ["花", "友情"],
    "level": 2
  },
  {
    "title": "滁州西涧",
    "author": "韦应物",
    "dynasty": "唐",
    "lines": ["独怜幽草涧边生，", "上有黄鹂深树鸣。", "春潮带雨晚来急，", "野渡无人舟自横。"],
    "tags": ["春天", "雨"],
    "level": 2
  },
  {
    "title": "秋夜寄邱员外",
    "author": "韦应物",
    "dynasty": "唐",
    "lines": ["怀君属秋夜，", "散步咏凉天。", "空山松子落，", "幽人应未眠。"],
    "tags": ["友情", "秋天"],
    "level": 2
  },
  {
    "title": "闻雁",
    "author": "韦应物",
    "dynasty": "唐",
    "lines": ["故园渺何处，", "归思方悠哉。", "淮南秋雨夜，", "高斋闻雁来。"],
    "tags": ["思乡", "秋天"],
    "level": 2
  },
  {
    "title": "赋得暮雨送李胄",
    "author": "韦应物",
    "dynasty": "唐",
    "lines": ["楚江微雨里，", "建业暮钟时。", "漠漠帆来重，", "冥冥鸟去迟。", "海门深不见，", "浦树远含滋。", "相送情无限，", "沾襟比散丝。"],
    "tags": ["送别", "雨"],
    "level": 3
  },
  {
    "title": "乌衣巷",
    "author": "刘禹锡",
    "dynasty": "唐",
    "lines": ["朱雀桥边野草花，", "乌衣巷口夕阳斜。", "旧时王谢堂前燕，", "飞入寻常百姓家。"],
    "tags": ["时间", "思乡"],
    "level": 2
  },
  {
    "title": "望洞庭",
    "author": "刘禹锡",
    "dynasty": "唐",
    "lines": ["湖光秋月两相和，", "潭面无风镜未磨。", "遥望洞庭山水翠，", "白银盘里一青螺。"],
    "tags": ["山水", "秋天"],
    "level": 2
  },
  {
    "title": "浪淘沙",
    "author": "刘禹锡",
    "dynasty": "唐",
    "lines": ["九曲黄河万里沙，", "浪淘风簸自天涯。", "如今直上银河去，", "同到牵牛织女家。"],
    "tags": ["山水", "励志"],
    "level": 2
  },
  {
    "title": "竹枝词",
    "author": "刘禹锡",
    "dynasty": "唐",
    "lines": ["杨柳青青江水平，", "闻郎江上踏歌声。", "东边日出西边雨，", "道是无晴却有晴。"],
    "tags": ["春天", "友情"],
    "level": 2
  },
  {
    "title": "石头城",
    "author": "刘禹锡",
    "dynasty": "唐",
    "lines": ["山围故国周遭在，", "潮打空城寂寞回。", "淮水东边旧时月，", "夜深还过女墙来。"],
    "tags": ["时间", "山水"],
    "level": 3
  },
  {
    "title": "秋词",
    "author": "刘禹锡",
    "dynasty": "唐",
    "lines": ["自古逢秋悲寂寥，", "我言秋日胜春朝。", "晴空一鹤排云上，", "便引诗情到碧霄。"],
    "tags": ["秋天", "励志"],
    "level": 2
  },
  {
    "title": "再游玄都观",
    "author": "刘禹锡",
    "dynasty": "唐",
    "lines": ["百亩庭中半是苔，", "桃花净尽菜花开。", "种桃道士归何处，", "前度刘郎今又来。"],
    "tags": ["花", "时间"],
    "level": 2
  },
  {
    "title": "采莲曲",
    "author": "贺知章",
    "dynasty": "唐",
    "lines": ["稽山云雾郁嵯峨，", "镜水无风也自波。", "莫言春度芳菲尽，", "别有中流采芰荷。"],
    "tags": ["植物", "山水"],
    "level": 2
  },
  {
    "title": "凉州词",
    "author": "王之涣",
    "dynasty": "唐",
    "lines": ["黄河远上白云间，", "一片孤城万仞山。", "羌笛何须怨杨柳，", "春风不度玉门关。"],
    "tags": ["边塞", "思乡"],
    "level": 2
  },
  {
    "title": "渔翁",
    "author": "柳宗元",
    "dynasty": "唐",
    "lines": ["渔翁夜傍西岩宿，", "晓汲清湘燃楚竹。", "烟销日出不见人，", "欸乃一声山水绿。", "回看天际下中流，", "岩上无心云相逐。"],
    "tags": ["山水", "动物"],
    "level": 3
  },
  {
    "title": "与浩初上人同看山寄京华亲故",
    "author": "柳宗元",
    "dynasty": "唐",
    "lines": ["海畔尖山似剑铓，", "秋来处处割愁肠。", "若为化得身千亿，", "散上峰头望故乡。"],
    "tags": ["思乡", "山水"],
    "level": 3
  },
  {
    "title": "枫桥夜泊",
    "author": "张继",
    "dynasty": "唐",
    "lines": ["月落乌啼霜满天，", "江枫渔火对愁眠。", "姑苏城外寒山寺，", "夜半钟声到客船。"],
    "tags": ["思乡", "秋天"],
    "level": 2
  },
  {
    "title": "题破山寺后禅院",
    "author": "常建",
    "dynasty": "唐",
    "lines": ["清晨入古寺，", "初日照高林。", "曲径通幽处，", "禅房花木深。", "山光悦鸟性，", "潭影空人心。", "万籁此俱寂，", "但余钟磬音。"],
    "tags": ["山水", "励志"],
    "level": 3
  },
  {
    "title": "寻隐者不遇",
    "author": "贾岛",
    "dynasty": "唐",
    "lines": ["松下问童子，", "言师采药去。", "只在此山中，", "云深不知处。"],
    "tags": ["山水", "励志"],
    "level": 1
  },
  {
    "title": "剑客",
    "author": "贾岛",
    "dynasty": "唐",
    "lines": ["十年磨一剑，", "霜刃未曾试。", "今日把示君，", "谁有不平事？"],
    "tags": ["励志", "时间"],
    "level": 2
  },
  {
    "title": "题诗后",
    "author": "贾岛",
    "dynasty": "唐",
    "lines": ["两句三年得，", "一吟双泪流。", "知音如不赏，", "归卧故山秋。"],
    "tags": ["励志", "读书"],
    "level": 2
  },
  {
    "title": "渡汉江",
    "author": "宋之问",
    "dynasty": "唐",
    "lines": ["岭外音书断，", "经冬复历春。", "近乡情更怯，", "不敢问来人。"],
    "tags": ["思乡", "时间"],
    "level": 2
  },
  {
    "title": "月黑雁飞高",
    "author": "卢纶",
    "dynasty": "唐",
    "lines": ["月黑雁飞高，", "单于夜遁逃。", "欲将轻骑逐，", "大雪满弓刀。"],
    "tags": ["边塞", "雪"],
    "level": 2
  },
  {
    "title": "林暗草惊风",
    "author": "卢纶",
    "dynasty": "唐",
    "lines": ["林暗草惊风，", "将军夜引弓。", "平明寻白羽，", "没在石棱中。"],
    "tags": ["边塞", "动物"],
    "level": 2
  },
  {
    "title": "夜上受降城闻笛",
    "author": "李益",
    "dynasty": "唐",
    "lines": ["回乐峰前沙似雪，", "受降城外月如霜。", "不知何处吹芦管，", "一夜征人尽望乡。"],
    "tags": ["边塞", "月亮"],
    "level": 2
  },
  {
    "title": "游子吟",
    "author": "孟郊",
    "dynasty": "唐",
    "lines": ["慈母手中线，", "游子身上衣。", "临行密密缝，", "意恐迟迟归。", "谁言寸草心，", "报得三春晖。"],
    "tags": ["母爱", "思乡"],
    "level": 2
  }
]