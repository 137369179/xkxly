# ============================================================
# 宝贝学习乐园 · 环境变量模板
# 复制为 .env.local 后填入真实值。.env.local 已被 gitignore。
# ============================================================

# ⚠️ 安全提醒：
# - 绝对不要将 .env.local 提交到 Git 或分享给他人
# - 定期轮换 API Key（建议每 90 天）
# - 生产环境使用密钥管理服务（AWS Secrets Manager / Vercel Env）
# - 不同环境使用不同的 Key（开发/测试/生产）

# —— 服务端（BFF 代理专用，绝不会进入前端 bundle）——
# StepFun（阶跃星辰）API Key，从 https://platform.stepfun.com 控制台获取；全站默认模型 step-3.7-flash
STEPFUN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# StepFun 接口地址（OpenAI 兼容）
STEPFUN_BASE_URL=https://api.stepfun.com/v1

# Agnes AI API Key（可选，旧模型族备用），从 https://www.agnes-ai.cn 控制台获取
AGNES_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Agnes AI 接口地址
AGNES_BASE_URL=https://api.agnes-ai.cn/v1

# BFF 代理监听端口
AI_PROXY_PORT=8787

# 全局并发上限（Agnes 未公开限流规则，客户端自行保护）
AI_MAX_CONCURRENCY=2

# 单请求超时（毫秒）
AI_TIMEOUT_MS=90000

# CORS 允许的来源（留空则不设置 Access-Control-Allow-Origin）
AI_ALLOW_ORIGIN=

# 是否由服务端托管静态文件（true/false）
AI_SERVE_STATIC=false

# 查看日志接口 /api/log 的鉴权 token（留空则禁止访问）
LOG_VIEW_TOKEN=

# 单 IP 每分钟最大请求数（限流保护）
AI_RATE_LIMIT_PER_MIN=30

# 每日 token 成本预算（cost cap；>0 启用，当日累计「text+reasoning+prompt」达此值即返回 429 并降级本地）
AI_DAILY_TOKEN_BUDGET=0


# —— 前端（VITE_ 前缀会被打包进 bundle，此处禁止放密钥）——
# 前端调用的代理地址。生产同源部署时留空即可（走相对路径 /api/ai）
VITE_AI_PROXY_URL=

# 全站默认模型
VITE_AI_DEFAULT_MODEL=step-3.7-flash

# Edge Neural TTS 的朗读令牌（可选覆盖；默认回退内置公开客户端令牌，非密钥，通常无需设置。
# 仅在自建代理/官方上游调整令牌时用于替换。）
VITE_EDGE_TTS_TOKEN=


# ============================================================
# 安全检查清单（部署前确认）：
# [ ] 已将真实 API Key 填入 .env.local（非此文件）
# [ ] .gitignore 包含 .env.local
# [ ] 生产环境未使用默认/示例 Key
# [ ] 已配置 CI/CD 环境变量（不硬编码在代码中）
# [ ] 已设置 Key 轮换计划
# ============================================================
