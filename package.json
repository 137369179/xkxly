{
  "name": "baby-learning-park",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "prebuild": "node scripts/clean-dist.mjs && node scripts/gen-sw-precache.mjs",
    "build": "tsc -b && vite build",
    "prerender": "node scripts/prerender.mjs",
    "build:seo": "npm run build && npm run prerender",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:stuck": "node scripts/ci-stuck-tests.mjs",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-results/junit.xml",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "smoke": "node scripts/smoke.mjs",
    "smoke:full": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "canvas-confetti": "^1.9.4",
    "motion": "^12.23.12",
    "pinyin-pro": "^3.28.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.185.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.10.0",
    "jsdom": "^30.0.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
